      "equations": [
        "p_c=c_omega_e*p_e;",
        "pi_c=pi+p_c-p_c(-1);",
        "pi_e=pi+p_e-p_e(-1);",
        "w_c=w-p_c;",
        "c_n=c+p_c;",
        "c_e=c+p_c-p_e;",
        "c=c_1*c(+1)+(1-c_1)*c(-1)-c_2*(r-pi_c(+1)-epsilon_b);",
        "i=i_1*i(-1)+(1-i_1)*i(+1)+i_2*q+epsilon_q;",
        "q=-(r-pi(+1)-epsilon_b)+q_1*r_k(+1)+(1-q_1)*q(+1);",
        "e_tot=c_weight_en*e_n+c_weight_ce*c_e;",
        "exports=p_e+e_tot;",
        "y=c_share_n*c_n+c_i_y*i+c_v_y*v+epsilon_g+c_share_x*exports;",
        "y=c_psi_p*(c_alpha*k+c_alpha_n*n+c_nu*e_n+epsilon_a);",
        "mc=c_alpha_n*w+c_alpha*r_k+c_nu*p_e-epsilon_a;",
        "e_n=mc+y/c_psi_p-p_e;",
        "k=w-r_k+n;",
        "pi-c_gamma_p*pi(-1)=pi_1*(pi(+1)-c_gamma_p*pi)-pi_2*(-mc+100*epsilon_p);",
        "w_c-w_c(-1)+pi_c=c_gamma_w*pi_c(-1)+c_beta*(w_c(+1)-w_c+pi_c(+1)-c_gamma_w*pi_c) -w_1*(c_omega*u-100*epsilon_w);",
        "c_omega*u=w_c-(z+epsilon_s+c_omega*e);",
        "c_omega*u_n=100*epsilon_w;",
        "l=u+e;",
        "z=(1-c_v)*z(-1)+c_v/(1-c_h/c_tau)*(c-c_h/c_tau*c(-1));",
        "k_bar=k_1*k_bar(-1)+(1-k_1)*i+k_2*epsilon_q;",
        "k=v+k_bar(-1);",
        "v=(1-c_psi)/c_psi*r_k;",
        "r=c_rho_intr*r(-1)+(1-c_rho_intr)*(c_r_pi*pi_c+c_r_y*y_gap+c_r_dy*(y_gap-y_gap(-1)))-epsilon_r;",
        "e-e(-1)=c_beta*(e(+1)-e)+e_1*(n-e);",
        "gdp=(y-c_share_en*e_n)/c_share_gdp;",
        "c_n_f=c_f+p_c;",
        "c_e_f=c_f+p_c-p_e;",
        "c_f=c_1*c_f(+1)+(1-c_1)*c_f(-1)-c_2*(r_f-epsilon_b);",
        "inv_f=i_1*inv_f(-1)+(1-i_1)*inv_f(+1)+i_2*q_f+epsilon_q;",
        "q_f=-(r_f+p_c(+1)-p_c-epsilon_b)+q_1*r_k_f(+1)+(1-q_1)*q_f(+1);",
        "e_tot_f=c_weight_en*e_n_f+c_weight_ce*c_e_f;",
        "exports_f=p_e+e_tot_f;",
        "y_f=c_share_n*c_n_f+c_i_y*inv_f+c_v_y*v_f+epsilon_g+c_share_x*exports_f;",
        "y_f=c_psi_p*(c_alpha*k_f+c_alpha_n*n_f+c_nu*e_n_f+epsilon_a);",
        "0=c_alpha_n*w_f+c_alpha*r_k_f+c_nu*p_e-epsilon_a;",
        "e_n_f=y_f/c_psi_p-p_e;",
        "w_f=p_c+z_f+epsilon_s+c_omega*n_f;",
        "z_f=(1-c_v)*z_f(-1)+c_v/(1-c_h/c_tau)*(c_f-c_h/c_tau*c_f(-1));",
        "k_bar_f=k_1*k_bar_f(-1)+(1-k_1)*inv_f+k_2*epsilon_q;",
        "k_f=v_f+k_bar_f(-1);",
        "v_f=(1-c_psi)/c_psi*r_k_f;",
        "k_f=w_f-r_k_f+n_f;",
        "e_f-e_f(-1)=c_beta*(e_f(+1)-e_f)+e_1*(n_f-e_f);",
        "gdp_f=(y_f-c_share_en*e_n_f)/c_share_gdp;",
        "y_gap=gdp-gdp_f;",
        "p_e=c_rho_e*p_e(-1)+eta_e;",
        "epsilon_b=c_rho_b*epsilon_b(-1)+eta_b;",
        "epsilon_q=c_rho_q*epsilon_q(-1)+eta_q;",
        "epsilon_g=c_rho_g*epsilon_g(-1)+eta_g+c_rho_g_a*eta_a;",
        "epsilon_a=c_rho_a*epsilon_a(-1)+eta_a;",
        "epsilon_p=c_rho_p*epsilon_p(-1)+eta_p-c_mu_p*eta_p(-1);",
        "epsilon_r=c_rho_r*epsilon_r(-1)+eta_r;",
        "epsilon_s=c_rho_s*epsilon_s(-1)+eta_s;",
        "epsilon_w=c_rho_w*epsilon_w(-1)+eta_w-c_mu_w*eta_w(-1);",
        "r_year=4*r;",
        "pi_year=pi_c+pi_c(-1)+pi_c(-2)+pi_c(-3);",
        "pi_d_year=pi+pi(-1)+pi(-2)+pi(-3);"
      ],
      "measurement": [
        "dy_obs=c_tau_bar+c_e_bar+gdp-gdp(-1);",
        "dc_obs=c_tau_bar+c_e_bar+c-c(-1);",
        "di_obs=c_tau_bar+c_e_bar+i-i(-1);",
        "pi_obs=c_pi_bar+pi_c;",
        "dw_obs=c_tau_bar+w-w(-1)+c_pi_bar+pi;",
        "de_obs=c_e_bar+e-e(-1);",
        "u_obs=c_u_bar+u;",
        "r_obs/4=c_r_bar+r;",
        "p_e_obs=p_e;",
        "pi_d_obs=c_pi_bar+pi;",
        "pi_e_obs=c_pi_bar+pi_e;",
        "p_f_obs=p_f;",
        "pi_f_obs=c_pi_bar+pi_f;"
