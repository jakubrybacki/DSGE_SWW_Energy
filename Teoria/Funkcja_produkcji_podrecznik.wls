(* Reproducible textbook notebook; originals are preserved. UTF-8. *)
Begin["ProductionTextbook`"];
ClearAll["ProductionTextbook`*"];
base=DirectoryName[$InputFileName];
cells={};
add[x_]:=(AppendTo[cells,x];);
txt[s_]:=add[Cell[s,"Text"]];
sec[s_]:=add[Cell[s,"Section"]];
sub[s_]:=add[Cell[s,"Subsection"]];
eq[s_]:=add[Cell[BoxData[ToBoxes[ToExpression[s,InputForm,Defer],TraditionalForm]],"DisplayFormula"]];
calc[s_]:=Module[{held,res},held=ToExpression[s,InputForm,Defer];add[Cell[BoxData[ToBoxes[held]],"Input"]];res=ToExpression[s];If[res=!=Null,add[Cell[BoxData[ToBoxes[res]],"Output"]]]];
add[Cell["Funkcja produkcji z energią","Title"]];
add[Cell["Od technologii do warunków optymalności i równań DSGE","Subtitle"]];
txt["Rozdział dla studenta. Najpierw wyprowadzamy wyniki na papierze i wyjaśniamy ich sens, a dopiero potem sprawdzamy rachunki w Wolfram Language. Materiał przepisuje część produkcyjną Funkcja_Cobb_Douglas_Energia.nb i rozwija blok firm z wyprowadzenie_rownan_sektora_energetycznego.wl. Oryginalne pliki pozostają zachowane. Część gospodarstw domowych (CES i podaż pracy) wymaga osobnego rozdziału."];
txt["Jak czytać: równania i tekst wystarczają do nauki bez uruchamiania kodu. Komórki Input oraz zapisane wyniki Output służą sprawdzeniu. Przy ponownym wykonywaniu używaj kolejności od góry do dołu i świeżego kernela. Symbole kodu: aa to A, kk to K, ll to L, ee to E_f, al to α, nv to ν, bb to β. Nie używamy E i N jako zmiennych, ponieważ mają znaczenie systemowe."];
sec["1. Technologia, oznaczenia i założenia"];
txt["Ustalmy jeden okres i pomińmy indeks czasu. X oznacza produkcję technologiczną przed odjęciem kosztu stałego. K jest nakładem usług kapitału, L nakładem pracy, a E_f energią zużywaną przez firmę. Energia jest nakładem pośrednim. A mierzy produktywność. W starym notebooku tę samą technologię oznaczono przez Y; tutaj rezerwujemy Y dla X pomniejszonego o koszt stały."];
eq["X == A K^alpha L^beta Ef^nu"];
eq["beta == 1-alpha-nu"];
eq["A>0 && K>0 && L>0 && Ef>0 && alpha>0 && nu>0 && alpha+nu<1"];
txt["Założenia dają 0<α,β,ν<1 i sumę wykładników równą jeden. Dodatnie nakłady definiują wnętrze dziedziny, gdzie wolno różniczkować i logarytmować. Domknięcie dziedziny dopuszcza nakłady równe zero przez ciągłe przedłużenie funkcji. Dodatnie ceny czynników będą potrzebne do istnienia zwykłego rozwiązania minimalizacji kosztów. A jest parametrem, który firma traktuje jako zadany."];
calc["bb=1-al-nv; f=aa kk^al ll^bb ee^nv; ass=aa>0&&kk>0&&ll>0&&ee>0&&al>0&&nv>0&&al+nv<1; FullSimplify[{al+bb+nv==1,0<bb<1},ass]"];
sec["2. Produkty krańcowe: rachunek krok po kroku"];
txt["Produkt krańcowy odpowiada na pytanie, o ile wzrośnie X po bardzo małym zwiększeniu jednego nakładu, gdy pozostałe nakłady i produktywność są stałe. Dla kapitału traktujemy A, L i E_f jak stałe i stosujemy regułę d(K^α)/dK=αK^(α−1)."];
eq["MPK == A L^beta Ef^nu alpha K^(alpha-1) == alpha X/K"];
txt["Ostatnia równość wynika z wyłączenia całego iloczynu A K^α L^β E_f^ν. Ten sam zabieg daje produkty pracy i energii."];
eq["MPL == beta X/L"];
eq["MPE == nu X/Ef"];
txt["Wszystkie trzy pochodne są dodatnie. Wykładniki są elastycznościami produkcji: wzrost K o około 1% podnosi X o około α%, przy stałych L, E_f i A. Elastyczność nie jest poziomem produktu krańcowego: α jest bez jednostki, a MPK ma jednostkę produkcji na jednostkę usług kapitału."];
calc["mp=FullSimplify[D[f,#]&/@{kk,ll,ee},ass]; mp"];
sub["Malejące produkty krańcowe i komplementarność"];
eq["D[ A K^alpha L^beta Ef^nu,{K,2}] == alpha (alpha-1) X/K^2 < 0"];
eq["D[ A K^alpha L^beta Ef^nu,K,Ef] == alpha nu X/(K Ef)>0"];
txt["Każdy czynnik ma malejący własny produkt krańcowy. Dodatnia pochodna mieszana mówi, że więcej energii zwiększa produkt krańcowy kapitału, przy pozostałych wielkościach stałych. Nie oznacza to braku substytucji przy wyborze kosztowym: dla tej technologii elastyczność substytucji między parami czynników wynosi jeden."];
calc["FullSimplify[{D[f,{kk,2}]<0,D[f,{ll,2}]<0,D[f,{ee,2}]<0,D[f,kk,ee]>0},ass]"];
sec["3. Korzyści skali, wklęsłość i granice wnioskowania"];
eq["F[s K,s L,s Ef] == s F[K,L,Ef]"];
txt["Dla s>0 wspólne pomnożenie nakładów przez s mnoży X przez s, ponieważ α+β+ν=1. To stałe korzyści skali. Nie należy ich mylić z malejącym produktem pojedynczego czynnika: tam zwiększamy jeden nakład, tutaj wszystkie naraz."];
eq["K MPK+L MPL+Ef MPE == X"];
txt["To twierdzenie Eulera o funkcji jednorodnej stopnia pierwszego. Technologia jest wklęsła, lecz nie jest ściśle wklęsła na całym dodatnim stożku: wzdłuż promienia skali jest liniowa. Można zobaczyć to bez wyznaczania wartości własnych hesjanu. Niech s_i będą udziałami α,β,ν, a v_i zmianą nakładu i podzieloną przez jego poziom. Wtedy forma kwadratowa hesjanu ma postać:"];
eq["z.H.z == X ((Sum[sh[i] v[i],{i,1,3}])^2-Sum[sh[i] v[i]^2,{i,1,3}])"];
txt["Ważona nierówność Cauchy’ego daje wartość nie większą od zera, gdy udziały są dodatnie i sumują się do jeden. Równość zachodzi, gdy wszystkie względne zmiany nakładów są takie same. Tą drogą uzasadniamy warunki drugiego rzędu, a jednocześnie widzimy, dlaczego sama wklęsłość nie gwarantuje unikalnej skali firmy."];
calc["FullSimplify[{kk D[f,kk]+ll D[f,ll]+ee D[f,ee]==f,(f/.{kk->ss kk,ll->ss ll,ee->ss ee})==ss f},ass&&ss>0]"];
sec["4. Minimalizacja kosztów: właściwy problem firmy"];
txt["Zadajmy dodatni cel produkcyjny Q. Firma wybiera nakłady po dodatnich cenach R_K, W i P_E. Wszystkie ceny i koszt krańcowy wyrażamy w tym samym numeraire, np. w jednostkach dobra krajowego. R_K jest ceną wynajmu usług kapitału; nie utożsamiamy jej automatycznie ze stopą procentową obligacji."];
eq["Minimize[{RK K+W L+PE Ef,A K^alpha L^beta Ef^nu>=Q && K>=0 && L>=0 && Ef>=0},{K,L,Ef}]"];
txt["Dla Q>0 żaden nakład nie może być zerowy, bo wszystkie są niezbędne. Ograniczenie produkcyjne wiąże: nadwyżka produkcji kosztowałaby niepotrzebnie więcej. Zapiszmy lagranżjan z mnożnikiem m≥0 przy ograniczeniu Q−F≤0."];
eq["lag == RK K+W L+PE Ef+m (Q-A K^alpha L^beta Ef^nu)"];
eq["RK-m MPK==0"];
eq["W-m MPL==0"];
eq["PE-m MPE==0"];
txt["Stąd R_K=mαQ/K, W=mβQ/L i P_E=mνQ/E_f. Mnożnik m jest kosztem uzyskania dodatkowej jednostki wymaganej produkcji (twierdzenie obwiedni). Przy stałych korzyściach skali jest także kosztem jednostkowym. Wypukły zbiór dopuszczalny i liniowy koszt sprawiają, że te warunki są wystarczające dla globalnego minimum. Dla dodatnich cen, udziałów i Q otrzymany zestaw nakładów jest jednoznaczny."];
calc["lag=rk kk+ww ll+pe ee+mm (qq-f); FullSimplify[D[lag,#]&/@{kk,ll,ee},ass]"];
sub["Relacje nakładów"];
txt["Dzieląc FOC kapitału przez FOC pracy, usuwamy m i Q. Następnie przekształcamy proporcję. Analogicznie postępujemy z energią."];
eq["RK/W == (alpha/beta) L/K"];
eq["K/L == (alpha/beta) W/RK"];
eq["Ef/L == (nu/beta) W/PE"];
txt["Droższa energia zmniejsza energię na jednostkę pracy przy stałych pozostałych cenach. Jest to relacja warunkowych popytów przy zadanej produkcji. W równowadze całego DSGE płace, produkcja i wykorzystanie kapitału mogą się równocześnie zmieniać."];
sec["5. Koszt jednostkowy i warunkowe popyty"];
txt["Pomnóżmy FOC przez odpowiednie nakłady i dodajmy. Z twierdzenia Eulera wynika koszt całkowity C=mQ. Następnie podstawiamy K=αmQ/R_K, L=βmQ/W i E_f=νmQ/P_E do ograniczenia technologicznego."];
eq["Q == A (alpha m Q/RK)^alpha (beta m Q/W)^beta (nu m Q/PE)^nu"];
txt["Ponieważ suma wykładników to jeden, po prawej można wyłączyć mQ. Dzielimy przez Q>0 i rozwiązujemy równanie względem m."];
eq["1 == A m (alpha/RK)^alpha (beta/W)^beta (nu/PE)^nu"];
eq["m == (1/A) (RK/alpha)^alpha (W/beta)^beta (PE/nu)^nu"];
eq["TC[Q] == m Q"];
eq["Kstar == alpha m Q/RK"];
eq["Lstar == beta m Q/W"];
eq["Efstar == nu m Q/PE"];
txt["Udziały α,β,ν są udziałami w kosztach zmiennych: R_K K/TC=α, W L/TC=β, P_E E_f/TC=ν. Ich utożsamienie z udziałami w przychodzie wymaga dodatkowego warunku dotyczącego ceny produktu i narzutu."];
calc["unit=(rk/al)^al (ww/bb)^bb (pe/nv)^nv/aa; dem={al unit qq/rk,bb unit qq/ww,nv unit qq/pe}; costsAss=ass&&rk>0&&ww>0&&pe>0&&qq>0; costChecks=FullSimplify[{(f/.Thread[{kk,ll,ee}->dem])==qq,{rk,ww,pe}.dem==unit qq,D[unit qq,rk]==dem[[1]],D[unit qq,ww]==dem[[2]],D[unit qq,pe]==dem[[3]]},costsAss]"];
txt["Ostatnie trzy kontrole to lemat Shepharda: pochodna kosztu minimalnego po cenie czynnika odtwarza jego warunkowy popyt. To niezależny sposób sprawdzenia rozwiązania."];
sec["6. Maksymalizacja zysku i problem skali"];
txt["Wyrażenie ze starego notebooka opisane jako ograniczenie budżetowe jest funkcją zysku. Jeśli P jest ceną jednostki produkcji, poprawny zapis przy swobodnym wyborze wszystkich nakładów brzmi:"];
eq["Pi == P X-RK K-W L-PE Ef"];
txt["Przy konkurencji doskonałej wewnętrzne FOC mają postać P·MP_i=cena_i. Podzielenie przez P daje produkty krańcowe równe realnym cenom czynników. To szczególny przypadek warunków kosztowych z m=P. Przy zadanej cenie i nieograniczonej skali funkcja zysku po minimalizacji kosztów ma postać:"];
eq["Pi[Q] == (P-m) Q"];
txt["Jeśli P<m, najlepsze jest Q=0. Jeśli P=m, wszystkie skale Q≥0 przynoszą zerowy zysk zmienny. Jeśli P>m, zysk jest nieograniczony z góry. Dlatego FOC przy stałych korzyściach skali nie wyznaczają same dodatniej, skończonej skali przedsiębiorstwa. W modelu równowagi skalę wiąże popyt, dostępność czynników albo inne ograniczenie."];
txt["Przy konkurencji monopolistycznej firma napotyka malejącą krzywą popytu i wybiera cenę/produkcję. W optymalnym wyborze nakładów nadal obowiązuje cena_i=m·MP_i, lecz na ogół m<P. Dla elastyczności popytu ε>1 i standardowego statycznego problemu cenowego P=ε/(ε−1)·m. Sztywności cen w DSGE wymagają dodatkowego dynamicznego problemu cenowego."];
sec["7. Warunki brzegowe i przypadki graniczne"];
sub["Zerowy nakład i granice Inady"];
txt["Dla dodatnich wykładników ciągłe przedłużenie daje F(0,L,E_f)=F(K,0,E_f)=F(K,L,0)=0. Każdy czynnik jest niezbędny do dodatniej produkcji. Nie obliczamy logarytmu zera i nie stosujemy wzorów MP_i=s_i X/z_i na brzegu, bo prowadzą do ilorazu 0/0. Używamy jednostronnych granic ze środka dziedziny."];
eq["Limit[MPK,K->0,Direction->\"FromAbove\"] == Infinity"];
eq["Limit[MPK,K->Infinity] == 0"];
txt["Analogiczne granice zachodzą dla pracy i energii przy pozostałych nakładach dodatnich i stałych. To warunki Inady dla pojedynczego czynnika. Gdy kilka nakładów jednocześnie dąży do zera, granica produktu krańcowego może zależeć od ścieżki. Nie wolno przenosić wniosku z granicy jednowymiarowej na dowolną ścieżkę do początku układu."];
calc["inada=Table[{Limit[D[f,z],z->0,Direction->\"FromAbove\",Assumptions->DeleteCases[ass, z>0]],Limit[D[f,z],z->Infinity,Assumptions->DeleteCases[ass,z>0]]},{z,{kk,ll,ee}}]; inada"];
sub["Kiedy FOC nie wystarczają"];
txt["Dla Q=0 i dodatnich cen minimalny koszt wynosi zero przy wszystkich nakładach równych zero. To rozwiązanie brzegowe, dla którego wewnętrzne FOC z dzieleniem przez nakład nie obowiązują. Ogólne warunki Kuhna–Tuckera obejmują dopuszczalność, nieujemność mnożników, stacjonarność tam, gdzie istnieją pochodne, i komplementarność. W punktach nieróżniczkowalnych potrzebny jest argument graniczny lub bezpośrednie porównanie kosztów."];
eq["m>=0 && Q-F[K,L,Ef]<=0 && m (Q-F[K,L,Ef])==0"];
txt["Przy zerowej cenie energii, dodatnim Q i dodatnich pozostałych cenach można zwiększać E_f bez kosztu i zmniejszać oba płatne nakłady. Kres dolny kosztu wynosi zero, lecz nie jest osiągany przez skończony zestaw nakładów. Ujemna cena nieograniczonego nakładu może prowadzić do kosztu nieograniczonego w dół. Dlatego zakładamy ceny ściśle dodatnie."];
sub["Granice parametrów"];
txt["Gdy ν→0, technologia dla dodatnich nakładów przechodzi do A K^α L^(1−α): energia staje się zbędna. W punkcie ν=0 trzeba zdefiniować model zredukowany, zamiast podstawiać mechanicznie E_f=0 do E_f^ν. Wyrażenia ν log ν interpretujemy granicznie jako zero. Gdy α+ν→1, udział pracy β zanika i również otrzymujemy technologię z mniejszą liczbą istotnych czynników. W tych punktach nie zachowujemy warunków Inady dla czynnika o zerowym udziale."];
txt["Jeżeli α+ν>1 przy β=1−α−ν, wykładnik pracy jest ujemny: więcej pracy obniża produkcję. To nie jest technologia o rosnących korzyściach skali; suma wykładników nadal wynosi jeden. Jeżeli A=0, dodatni cel Q jest niewykonalny. Przy A→0+ koszt jednostkowy rośnie bez ograniczenia."];
sec["8. Koszt stały i przejście do równań DSGE"];
txt["W szerszym notebooku modelu użyto Y=X−Φ, gdzie Φ≥0 to stałe zużycie dobra produkcyjnego. Y nie jest tu automatycznie PKB: odjęcie importowanych nakładów pośrednich jest osobnym krokiem rachunkowym. Dla aktywnej firmy i Φ stałego pochodne Y po nakładach są takie jak pochodne X, ale ilorazy w FOC zawierają X=Y+Φ."];
eq["Y == X-Phi"];
eq["W L == beta m X"];
eq["RK K == alpha m X"];
eq["PE Ef == nu m X"];
txt["Koszt uzyskania Y wynosi TC(Y)=m(Y+Φ); koszt krańcowy względem Y nadal wynosi m. Koszt średni m(1+Φ/Y) jest większy od m dla Y>0 i Φ>0. Jeśli firma może się zamknąć, trzeba osobno porównać zysk z działania i zysk po zamknięciu oraz ustalić, czy koszt stały jest wtedy unikany."];
sub["Logarytmiczne odchylenia od stanu ustalonego"];
eq["hatZ == Log[Z/Zbar]"];
txt["Kreska oznacza dodatni stan ustalony, a daszek logarytmiczne odchylenie. Dla czystej funkcji Cobba–Douglasa tożsamość w logach jest dokładna. Po odjęciu kosztu stałego przejście z X do Y jest przybliżeniem pierwszego rzędu."];
eq["hatX == hatA+alpha hatK+beta hatL+nu hatEf"];
eq["psi == Xbar/Ybar == 1+Phi/Ybar"];
eq["hatY == psi hatX"];
txt["Ostatnie równanie otrzymujemy z dY=dX i dY/Ȳ=(X̄/Ȳ)dX/X̄. Wymaga Ȳ>0, X̄>0 i stałego Φ. Gdy Φ zmienia się w czasie, dochodzi składnik −dΦ/Ȳ. Gdy Ȳ zbliża się do zera, ψ rośnie, a aproksymacja logarytmiczna Y staje się szczególnie wrażliwa. Dla Φ=0 mamy ψ=1."];
eq["hatW+hatL == hatm+hatX"];
eq["hatRK+hatK == hatm+hatX"];
eq["hatPE+hatEf == hatm+hatX"];
txt["Stałe udziały znikają z odchyleń od stanu ustalonego. Ważymy trzy FOC udziałami β,α,ν, dodajemy i podstawiamy technologię. Dostajemy:"];
eq["hatm == beta hatW+alpha hatRK+nu hatPE-hatA"];
eq["hatEf == hatm+hatY/psi-hatPE"];
eq["hatK == hatW-hatRK+hatL"];
txt["W pliku szerszego wyprowadzenia symbole te odpowiadają mc, w, rk, pE, en, k, n oraz cpsip=ψ. Jeśli wszystkie odchylenia mnożymy przez 100, liniowe równania mają te same współczynniki. Przy ustalonych udziałach logarytm kosztu jednostkowego jest dokładnie liniowy w logarytmach cen i A; przybliżenie dotyczy tu przede wszystkim przejścia Y=X−Φ."];
calc["weighted=bb (mh+xh-lh)+al (mh+xh-kh)+nv (mh+xh-eh); logCheck=FullSimplify[(weighted/.xh->ah+al kh+bb lh+nv eh)==mh+ah]; logCheck"];
sub["Udziały energii: koszt, przychód i PKB"];
eq["PE Ef/Y == nu m X/Y"];
txt["Przy cenie produktu znormalizowanej do jedności udział wydatków na energię w Y wynosi ν·m·X/Y. Równość tego udziału z ν wymaga dodatkowo m̄ψ=1. W szerszym notebooku przyjęto m̄=1/cpsip i X̄/Ȳ=cpsip, więc taki skrót jest uzasadniony w stanie ustalonym. Nie jest ogólną własnością dowolnej kalibracji ani udziałem energii w PKB."];
sec["9. Przykład liczbowy i wykres"];
txt["Przyjmijmy A=1, α=0,30, ν=0,10 i β=0,60. Niech wszystkie ceny czynników wynoszą 1, a Q=10. Koszt jednostkowy nie musi wynosić 1 nawet przy A=1 i cenach równych 1: zależy od normalizacji technologii i udziałów."];
calc["example={aa->1,al->3/10,nv->1/10,rk->1,ww->1,pe->1,qq->10}; N[<|\"Koszt jednostkowy\"->unit,\"Nakłady K,L,E_f\"->dem,\"Koszt całkowity\"->unit qq,\"Udział energii w koszcie\"->pe dem[[3]]/(unit qq)|>/.example,6]"];
txt["Na wykresie pozostawiamy K=L=A=1 i zmieniamy tylko energię. Produkcja rośnie coraz wolniej. Produkt krańcowy energii maleje; wykres zaczyna się od dodatniego nakładu, ponieważ przy zerze pochodna ma nieskończoną granicę."];
calc["Plot[Evaluate[{f,D[f,ee]}/.{aa->1,kk->1,ll->1,al->3/10,nv->1/10}],{ee,0.02,4},PlotLegends->{\"Produkcja X\",\"Produkt krańcowy energii\"},AxesLabel->{\"E_f\",\"Wartość\"},ImageSize->560,PlotRange->All]"];
sec["10. Sprawdź zrozumienie"];
txt["1. Dlaczego malejący MPK jest zgodny ze stałymi korzyściami skali? 2. Co dzieje się z E_f/L, gdy cena energii wzrasta o 10%, a płaca jest stała? 3. Czy ν jest zawsze udziałem energii w przychodzie? 4. Dlaczego nie wolno log-linearyzować wokół Ȳ=0? 5. Czy przy stałych cenach czynników podwojenie Q zmienia koszt jednostkowy?"];
sub["Wskazówki do odpowiedzi"];
txt["1. W pierwszym porównaniu zmienia się tylko K, w drugim wszystkie nakłady. 2. Relacja mnoży się przez 1/1,1, więc spada o około 9,09% (lokalnie: −10%). 3. Jest udziałem w koszcie zmiennym; udział w przychodzie zależy od m/P i definicji produkcji. 4. Logarytm i procentowa zmiana względem zera nie są zdefiniowane. 5. Nie: koszt całkowity i każdy warunkowy popyt podwajają się."];
sec["11. Kontrola rachunków i uwagi redakcyjne"];
txt["Rachunki kosztowe zostały również sprawdzone przez konektor Wolfram. Kontrole poniżej muszą zwrócić True. Przy przepisywaniu usunięto komórki diagnostyczne typu ?L, oddzielono zysk od ograniczenia technologicznego, rozróżniono R_K od stopy obligacji i jawnie dodano założenia. Nie używamy PowerExpand do rozdzielania potęg bez kontroli dziedziny. Część CES ze starego notebooka powinna zachować osobne oznaczenia i osobno omawiać granicę σ→1."];
calc["allChecks=And@@Join[costChecks,{logCheck},FullSimplify[{kk D[f,kk]+ll D[f,ll]+ee D[f,ee]==f,D[f,{kk,2}]<0,D[f,{ll,2}]<0,D[f,{ee,2}]<0},ass]]; allChecks"];
If[!TrueQ[allChecks],Print["CHECK FAILURE"];Exit[2]];
nb=Notebook[cells,StyleDefinitions->"Default.nb",WindowTitle->"Funkcja produkcji — rozdział podręcznikowy",WindowSize->{1100,850},Magnification->1.1,PrintingOptions->{"PaperSize"->{595.3,841.9}},TaggingRules-><|"Language"->"Polish","SourceNotebooks"->{"Funkcja_Cobb_Douglas_Energia.nb","wyprowadzenie_rownan_sektora_energetycznego.nb"}|>];
out=FileNameJoin[{base,"Funkcja_produkcji_podrecznik.nb"}];
Put[nb,out];
parsed=Get[out];
Print["Notebook: ",out];
Print["Cells: ",Length[cells],"; Checks: ",allChecks,"; Parsed: ",Head[parsed]===Notebook];
End[];