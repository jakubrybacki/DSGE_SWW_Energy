   CellFrameLabels -> {{None, "(81)"}, {None, None}}], 
  Cell[BoxData[RowBox[{FormBox[SubscriptBox["s", StyleBox["C", 
         FontSlant -> Italic, StripOnInput -> False]], TraditionalForm], "=", 
      RowBox[{"1", RowBox[{"-", RowBox[{FractionBox["I", "Y"]}]}], 
