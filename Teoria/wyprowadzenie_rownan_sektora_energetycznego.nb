        FormBox["\[Tau]", TraditionalForm], "\[ThinSpace]", 
        FormBox[SubscriptBox["\[Phi]", "\[ImaginaryI]"], 
         TraditionalForm]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(18)"}, {None, None}}], 
  Cell["cphi=\[CurlyPhi]I measures investment adjustment curvature. The lag \
in k=v+kbar(\[Minus]1) means installed capital is predetermined when current \
services are used. Utilisation v adjusts the services flow, and a higher \
rental return raises its desired intensity. cpsi=\[Psi]U is the utilisation \
parameter.", "Text"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["k", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["v", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"+", SubscriptBox[FormBox[OverscriptBox[StyleBox["k", Italic, 
              StripOnInput -> False], "_"], TraditionalForm], 
           RowBox[{FormBox["t", TraditionalForm], RowBox[
              {"-", "1"}]}]]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(19)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["v", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{FractionBox[RowBox[{RowBox[{"(", RowBox[{"1", RowBox[
                {"-", RowBox[{FormBox[SubscriptBox["\[Psi]", "U"], 
                    TraditionalForm]}]}]}], ")"}]}], 
         RowBox[{FormBox[SubscriptBox["\[Psi]", "U"], TraditionalForm]}]], 
        "\[ThinSpace]", SubscriptBox[FormBox[SubscriptBox[
           StyleBox["r", Italic, StripOnInput -> False], "K"], 
          TraditionalForm], FormBox["t", TraditionalForm]]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(20)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["q", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{RowBox[{"-", RowBox[{RowBox[{"(", RowBox[{SubscriptBox[
                 FormBox["r", TraditionalForm], FormBox["t", 
                  TraditionalForm]], RowBox[{"-", RowBox[{RowBox[
                     {SubscriptBox["\[DoubleStruckCapitalE]", FormBox["t", 
                        TraditionalForm]], "[", SubscriptBox[FormBox["\[Pi]", 
                        TraditionalForm], RowBox[{FormBox["t", 
                          TraditionalForm], RowBox[{"+", "1"}]}]], "]"}]}]}], 
                RowBox[{"-", RowBox[{SubscriptBox[FormBox[SubscriptBox[
                       "\[Epsilon]", "b"], TraditionalForm], FormBox["t", 
                      TraditionalForm]]}]}]}], ")"}]}]}], 
        RowBox[{"+", RowBox[{FormBox[SubscriptBox["q", "1"], 
             TraditionalForm], "\[ThinSpace]", RowBox[
             {SubscriptBox["\[DoubleStruckCapitalE]", FormBox["t", 
                TraditionalForm]], "[", SubscriptBox[FormBox[SubscriptBox[
                 StyleBox["r", Italic, StripOnInput -> False], "K"], 
                TraditionalForm], RowBox[{FormBox["t", TraditionalForm], 
                 RowBox[{"+", "1"}]}]], "]"}]}]}], 
        RowBox[{"+", RowBox[{RowBox[{"(", RowBox[{"1", RowBox[{"-", 
                  RowBox[{FormBox[SubscriptBox["q", "1"], 
                     TraditionalForm]}]}]}], ")"}], "\[ThinSpace]", 
            RowBox[{SubscriptBox["\[DoubleStruckCapitalE]", FormBox["t", 
                TraditionalForm]], "[", SubscriptBox[FormBox["q", 
                TraditionalForm], RowBox[{FormBox["t", TraditionalForm], 
                 RowBox[{"+", "1"}]}]], "]"}]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(21)"}, {None, None}}], 
  Cell[BoxData[RowBox[{FormBox[SubscriptBox["q", "1"], TraditionalForm], "=", 
      FractionBox[RowBox[{FormBox[OverscriptBox[SubscriptBox["R", 
            StyleBox["K", FontSlant -> Italic, StripOnInput -> False]], "_"], 
          TraditionalForm]}], RowBox[
        {RowBox[{"(", RowBox[{FormBox[OverscriptBox[SubscriptBox["R", 
                StyleBox["K", FontSlant -> Italic, StripOnInput -> False]], 
               "_"], TraditionalForm], RowBox[{"+", "1"}], 
             RowBox[{"-", RowBox[{FormBox["\[Delta]", TraditionalForm]}]}]}], 
           ")"}]}]]}]], "DisplayFormula", CellFrameLabels -> 
    {{None, "(22)"}, {None, None}}], Cell["The capital-value condition \
discounts domestic-good rental and resale payoffs. Since q is measured in \
domestic investment goods, its real-rate deflator remains domestic inflation \
pi, even when consumption uses CPI. The weights q1 and 1\[Minus]q1 are the \
steady rental and undepreciated resale shares in the total capital payoff.", 
   "Text"], Cell["2.3 Production and fixed costs in the classic model", 
   "Subsection"], 
  Cell["Constant returns, marginal productivity and fixed costs", 
   "Subsection"], Cell["A production exponent is an elasticity: it describes \
the percentage change in output from a small percentage change in an input, \
holding other inputs fixed. The sum of the exponents determines returns to \
scale. When it is one, doubling all variable inputs doubles technological \
output X. This does not contradict a decreasing marginal product of capital: \
that statement increases capital alone while holding labour and, in the \
sectoral version, energy fixed.", "Text"], Cell["The fixed cost Phi is \
expressed in units of the domestic good. It reduces saleable output from X to \
Y, but does not change how much an additional small input contributes to X. \
It creates a distinction between marginal cost and average cost: resources \
needed to cover a fixed requirement are spread over more units as production \
expands. In the local model, the steady fixed-cost and markup normalisations \
are tied through cpsip. That equality is a maintained calibration convention, \
not a universal property of any economy with a fixed cost.", "Text"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["X", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["A", TraditionalForm], 
         FormBox["t", TraditionalForm]], "\[ThinSpace]", 
        SuperscriptBox[SubscriptBox[FormBox[StyleBox["K", 
            FontSlant -> Italic, StripOnInput -> False], TraditionalForm], 
          FormBox["t", TraditionalForm]], FormBox["\[Alpha]", 
          TraditionalForm]], "\[ThinSpace]", SuperscriptBox[
         SubscriptBox[FormBox[StyleBox["N", FontSlant -> Italic, 
            StripOnInput -> False], TraditionalForm], FormBox["t", 
           TraditionalForm]], RowBox[{"1", RowBox[
            {"-", RowBox[{FormBox["\[Alpha]", TraditionalForm]}]}]}]]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(23)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["Y", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["X", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"-", RowBox[{FormBox["\[CapitalPhi]", 
             TraditionalForm]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(24)"}, {None, None}}], 
  Cell[BoxData[RowBox[{FormBox[SubscriptBox["\[Psi]", 
        StyleBox["P", FontSlant -> Italic, StripOnInput -> False]], 
       TraditionalForm], "=", FractionBox[
       RowBox[{FormBox[OverscriptBox["X", "_"], TraditionalForm]}], 
       RowBox[{FormBox[OverscriptBox["Y", "_"], TraditionalForm]}]]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(25)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["y", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{FormBox[SubscriptBox["\[Psi]", StyleBox["P", 
           FontSlant -> Italic, StripOnInput -> False]], TraditionalForm], 
        "\[ThinSpace]", RowBox[{"(", RowBox[{SubscriptBox[FormBox["a", 
              TraditionalForm], FormBox["t", TraditionalForm]], 
            RowBox[{"+", RowBox[{FormBox["\[Alpha]", TraditionalForm], 
                "\[ThinSpace]", SubscriptBox[FormBox["k", TraditionalForm], 
                 FormBox["t", TraditionalForm]]}]}], 
            RowBox[{"+", RowBox[{RowBox[{"(", RowBox[{"1", RowBox[{"-", 
                      RowBox[{FormBox["\[Alpha]", TraditionalForm]}]}]}], 
                  ")"}], "\[ThinSpace]", SubscriptBox[FormBox["n", 
                  TraditionalForm], FormBox["t", TraditionalForm]]}]}]}], 
          ")"}]}]}]], "DisplayFormula", CellFrameLabels -> 
    {{None, "(26)"}, {None, None}}], Cell["For constant \[CapitalPhi] and \
Y\:0304>0, dY=dX and dY/Y\:0304=(X\:0304/Y\:0304)dX/X\:0304. This explains \
cpsip=\[Psi]P in the linear production function. Log additivity for X is \
exact; mapping X to Y is first-order. Without imported intermediate inputs, Y \
also serves as GDP in the classic output gap and measurement equation.", 
   "Text"], Cell[BoxData[RowBox[{SubscriptBox[FormBox["y", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{RowBox[{FormBox[SubscriptBox["s", StyleBox["C", 
             FontSlant -> Italic, StripOnInput -> False]], TraditionalForm], 
          "\[ThinSpace]", SubscriptBox[FormBox["c", TraditionalForm], 
           FormBox["t", TraditionalForm]]}], 
        RowBox[{"+", RowBox[{FormBox[SubscriptBox["s", "\[ImaginaryI]"], 
             TraditionalForm], "\[ThinSpace]", SubscriptBox[
             FormBox["i", TraditionalForm], FormBox["t", 
              TraditionalForm]]}]}], RowBox[
         {"+", RowBox[{FormBox[SubscriptBox["s", "V"], TraditionalForm], 
            "\[ThinSpace]", SubscriptBox[FormBox["v", TraditionalForm], 
             FormBox["t", TraditionalForm]]}]}], 
        RowBox[{"+", SubscriptBox[FormBox[SubscriptBox[StyleBox["g", Italic, 
              StripOnInput -> False], "contribution"], TraditionalForm], 
           FormBox["t", TraditionalForm]]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(27)"}, {None, None}}], 
  Cell["This linear resource equation follows from Y=C+I+UtilisationCost+G. \
The coefficients are steady expenditure shares or, for utilisation, the \
derivative of its cost divided by Y\:0304. epsilong=gcontrib is already a \
weighted additive contribution, not an unweighted government log deviation. A \
zero steady utilisation cost need not imply a zero marginal utilisation \
cost.", "Text"], 
  Cell["3. Derive commodity demand and the consumption price index", 
   "Section"], Cell["3.1 Energy-food consumption basket", "Subsection"], 
  Cell["Let sN=1\[Minus]\[Omega]E\[Minus]\[Omega]F, sE=\[Omega]E and \
sF=\[Omega]F, all positive. CN is domestic non-energy non-food consumption, \
CE household energy and CF imported food. Both sectoral models implement a \
Cobb\[Dash]Douglas basket with unit elasticity of substitution, not a general \
CES basket with a freely varying substitution parameter.", "Text"], 
  Cell["Why introduce a consumption basket?", "Subsection"], 
  Cell["A household consumes different goods but needs a single index to \
describe the flow of consumption services entering utility. The basket is \
such an index. It is not obtained by simply adding tonnes of energy, food \
quantities and domestic goods. Its aggregation rule specifies how \
combinations of goods substitute for one another. The associated consumption \
price index tells us the minimum expenditure needed to purchase one unit of \
that composite at current prices.", "Text"], Cell["The Cobb-Douglas rule \
imposes two strong restrictions. First, all positively weighted components \
are essential for a positive composite, so an interior derivation uses \
positive quantities. Second, optimal expenditure shares are constant. With \
positive prices, the household spends the fraction omegaE on energy and \
omegaF on imported food, although the purchased quantities change with \
prices. Constant shares do not mean constant quantities. When the energy \
price rises, energy demand falls so that its expenditure share remains fixed \
at the optimum.", "Text"], Cell["A unit substitution elasticity means that, \
conditionally on the basket's required service level, a one-percent change in \
a relative price produces an approximately one-percent change in the \
corresponding relative quantity. This is a tractable benchmark, not an \
empirical claim that households can easily replace every energy service or \
food product. Allowing a different elasticity requires a general CES \
aggregator and changes the demand equations and price index. The local \
implementation deliberately uses the simpler unit-elastic case.", "Text"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[StyleBox["C", 
         FontSlant -> Italic, StripOnInput -> False], TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SuperscriptBox[RowBox[{"(", FractionBox[
            RowBox[{SubscriptBox[FormBox[SubscriptBox[StyleBox["C", 
                  FontSlant -> Italic, StripOnInput -> False], StyleBox["N", 
                  FontSlant -> Italic, StripOnInput -> False]], 
                TraditionalForm], FormBox["t", TraditionalForm]]}], 
            RowBox[{FormBox[SubscriptBox["s", StyleBox["N", FontSlant -> 
                  Italic, StripOnInput -> False]], TraditionalForm]}]], 
           ")"}], FormBox[SubscriptBox["s", StyleBox["N", 
            FontSlant -> Italic, StripOnInput -> False]], TraditionalForm]], 
        "\[ThinSpace]", SuperscriptBox[RowBox[{"(", FractionBox[
            RowBox[{SubscriptBox[FormBox[SubscriptBox[StyleBox["C", 
                  FontSlant -> Italic, StripOnInput -> False], StyleBox["E", 
                  FontSlant -> Plain, StripOnInput -> False]], 
                TraditionalForm], FormBox["t", TraditionalForm]]}], 
            RowBox[{FormBox[SubscriptBox["s", StyleBox["E", FontSlant -> 
                  Plain, StripOnInput -> False]], TraditionalForm]}]], ")"}], 
         FormBox[SubscriptBox["s", StyleBox["E", FontSlant -> Plain, 
            StripOnInput -> False]], TraditionalForm]], "\[ThinSpace]", 
        SuperscriptBox[RowBox[{"(", FractionBox[RowBox[
             {SubscriptBox[FormBox[SubscriptBox[StyleBox["C", FontSlant -> 
                   Italic, StripOnInput -> False], StyleBox["F", FontSlant -> 
                   Plain, StripOnInput -> False]], TraditionalForm], FormBox[
                "t", TraditionalForm]]}], RowBox[{FormBox[SubscriptBox["s", 
                StyleBox["F", FontSlant -> Plain, StripOnInput -> False]], 
               TraditionalForm]}]], ")"}], FormBox[SubscriptBox["s", 
           StyleBox["F", FontSlant -> Plain, StripOnInput -> False]], 
          TraditionalForm]]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(28)"}, {None, None}}], 
  Cell[BoxData[RowBox[
     {RowBox[{FormBox[SubscriptBox["s", StyleBox["N", FontSlant -> Italic, 
           StripOnInput -> False]], TraditionalForm], 
        RowBox[{"+", FormBox[SubscriptBox["s", StyleBox["E", 
             FontSlant -> Plain, StripOnInput -> False]], TraditionalForm]}], 
        RowBox[{"+", FormBox[SubscriptBox["s", StyleBox["F", 
             FontSlant -> Plain, StripOnInput -> False]], 
           TraditionalForm]}]}], "=", "1"}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(29)"}, {None, None}}], 
  Cell["Minimise PD\[CenterDot]CN+PE\[CenterDot]CE+PF\[CenterDot]CF for a \
required composite C. The composite derivative is s_j C/C_j, so the cost FOC \
is P_j=\[Xi] s_j C/C_j. Multiply each FOC by C_j and add: expenditure equals \
\[Xi]C. Substituting the demands back into the aggregator yields \[Xi]=PC, \
the unit-expenditure function.", "Text"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["Pj", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["\[Xi]", TraditionalForm], 
         FormBox["t", TraditionalForm]], "\[ThinSpace]", 
        FormBox["sj", TraditionalForm], "\[ThinSpace]", 
        FractionBox[RowBox[{SubscriptBox[FormBox[StyleBox["C", 
              FontSlant -> Italic, StripOnInput -> False], TraditionalForm], 
            FormBox["t", TraditionalForm]]}], 
         RowBox[{SubscriptBox[FormBox["Cj", TraditionalForm], 
            FormBox["t", TraditionalForm]]}]]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(30)"}, {None, None}}], 
