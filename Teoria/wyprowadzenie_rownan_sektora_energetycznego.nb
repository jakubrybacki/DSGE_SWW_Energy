   CellFrameLabels -> {{None, "(100)"}, {None, None}}], 
  Cell["The flexible real rate rf is measured in consumption units. Convert \
it to a domestic-good real rate by adding the expected change in PC/PD before \
discounting domestic capital returns. Since pc=0 in the classic model, the \
conversion is invisible there but necessary in the sectoral versions.", 
   "Text"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[TemplateBox[{"q", "f"}, 
         "Superscript", SyntaxForm -> SuperscriptBox], TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{RowBox[{"-", RowBox[{RowBox[{"(", RowBox[{SubscriptBox[
                 FormBox[TemplateBox[{"r", "f"}, "Superscript", SyntaxForm -> 
                    SuperscriptBox], TraditionalForm], FormBox["t", 
                  TraditionalForm]], RowBox[{"+", RowBox[{SubscriptBox[
                     "\[DoubleStruckCapitalE]", FormBox["t", 
                      TraditionalForm]], "[", SubscriptBox[FormBox[
                      SubscriptBox["p", StyleBox["C", FontSlant -> Italic, 
                        StripOnInput -> False]], TraditionalForm], RowBox[
                      {FormBox["t", TraditionalForm], RowBox[{"+", "1"}]}]], 
                    "]"}]}], RowBox[{"-", RowBox[{SubscriptBox[FormBox[
                      SubscriptBox["p", StyleBox["C", FontSlant -> Italic, 
                        StripOnInput -> False]], TraditionalForm], FormBox[
                      "t", TraditionalForm]]}]}], RowBox[{"-", RowBox[
                   {SubscriptBox[FormBox[SubscriptBox["\[Epsilon]", "b"], 
                      TraditionalForm], FormBox["t", TraditionalForm]]}]}]}], 
              ")"}]}]}], RowBox[{"+", RowBox[{FormBox[SubscriptBox["q", "1"], 
             TraditionalForm], "\[ThinSpace]", RowBox[
             {SubscriptBox["\[DoubleStruckCapitalE]", FormBox["t", 
                TraditionalForm]], "[", SubscriptBox[FormBox[TemplateBox[
                 {SubscriptBox[StyleBox["r", Italic, StripOnInput -> False], 
                   "K"], "f"}, "Superscript", SyntaxForm -> SuperscriptBox], 
                TraditionalForm], RowBox[{FormBox["t", TraditionalForm], 
                 RowBox[{"+", "1"}]}]], "]"}]}]}], 
        RowBox[{"+", RowBox[{RowBox[{"(", RowBox[{"1", RowBox[{"-", 
                  RowBox[{FormBox[SubscriptBox["q", "1"], 
                     TraditionalForm]}]}]}], ")"}], "\[ThinSpace]", 
            RowBox[{SubscriptBox["\[DoubleStruckCapitalE]", FormBox["t", 
                TraditionalForm]], "[", SubscriptBox[FormBox[TemplateBox[
                 {"q", "f"}, "Superscript", SyntaxForm -> SuperscriptBox], 
                TraditionalForm], RowBox[{FormBox["t", TraditionalForm], 
                 RowBox[{"+", "1"}]}]], "]"}]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(101)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[TemplateBox[
         {StyleBox["gdp", Italic, StripOnInput -> False], "f"}, 
         "Superscript", SyntaxForm -> SuperscriptBox], TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", FractionBox[
       RowBox[{RowBox[{"(", RowBox[{SubscriptBox[FormBox[TemplateBox[
