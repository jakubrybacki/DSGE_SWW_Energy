                        Italic, StripOnInput -> False]}, "Superscript", 
                     SyntaxForm -> SuperscriptBox], TraditionalForm], 
                   RowBox[{FormBox["t", TraditionalForm], RowBox[{"+", 
                       "1"}]}]]}], RowBox[{"-", RowBox[{FormBox[SubscriptBox[
                      "\[Gamma]", "W"], TraditionalForm], "\[ThinSpace]", 
                    SubscriptBox[FormBox[TemplateBox[{"\[Pi]", StyleBox["C", 
                         FontSlant -> Italic, StripOnInput -> False]}, 
                       "Superscript", SyntaxForm -> SuperscriptBox], 
                      TraditionalForm], FormBox["t", TraditionalForm]]}]}]}], 
              "]"}]}]}], RowBox[{"-", RowBox[
           {FormBox[SubscriptBox["\[Kappa]", "W"], TraditionalForm], 
            "\[ThinSpace]", RowBox[{"(", RowBox[{RowBox[{FormBox[SubscriptBox[
                    "\[Omega]", "U"], TraditionalForm], "\[ThinSpace]", 
                  SubscriptBox[FormBox["u", TraditionalForm], FormBox["t", 
                    TraditionalForm]]}], RowBox[{"-", RowBox[{"100", 
                    "\[ThinSpace]", SubscriptBox[FormBox[SubscriptBox[
                       "\[Epsilon]", "w"], TraditionalForm], FormBox["t", 
                      TraditionalForm]]}]}]}], ")"}]}]}]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(46)"}, {None, None}}], 
  Cell[BoxData[RowBox[{FormBox[SubscriptBox["\[Kappa]", "W"], 
       TraditionalForm], "=", FractionBox[
       RowBox[{RowBox[{RowBox[{"(", RowBox[{"1", RowBox[{"-", RowBox[
                  {FormBox[SubscriptBox["\[Theta]", "W"], TraditionalForm], 
                   "\[ThinSpace]", FormBox["\[Beta]", TraditionalForm]}]}]}], 
             ")"}], "\[ThinSpace]", RowBox[{"(", RowBox[{"1", RowBox[
                {"-", RowBox[{FormBox[SubscriptBox["\[Theta]", "W"], 
                    TraditionalForm]}]}]}], ")"}]}]}], 
       RowBox[{RowBox[{FormBox[SubscriptBox["\[Theta]", "W"], 
            TraditionalForm], "\[ThinSpace]", RowBox[
            {"(", RowBox[{"1", RowBox[{"+", RowBox[{FormBox[SubscriptBox[
                     "\[Omega]", "U"], TraditionalForm], "\[ThinSpace]", 
                   FormBox[SubscriptBox["\[CurlyEpsilon]", "W"], 
                    TraditionalForm]}]}]}], ")"}]}]}]]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(47)"}, {None, None}}], 
  Cell["The left side is nominal wage inflation: \
\[CapitalDelta]wc+piC=\[CapitalDelta]w+pi. This cancellation is a \
unit-conversion identity. Indexing wages to CPI on the right instead of \
domestic inflation is a substantive modelling choice in the sectoral files, \
not an implication of accounting alone. This sticky-wage unemployment block \
should not be replaced by a frictionless household labour FOC.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{FormBox[SubscriptBox["\[Omega]", "U"], 
         TraditionalForm], "\[ThinSpace]", SubscriptBox[
         FormBox["un", TraditionalForm], FormBox["t", TraditionalForm]]}], 
      "=", RowBox[{"100", "\[ThinSpace]", SubscriptBox[
         FormBox[SubscriptBox["\[Epsilon]", "w"], TraditionalForm], 
         FormBox["t", TraditionalForm]]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(48)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["l", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["u", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"+", SubscriptBox[FormBox["e", TraditionalForm], 
           FormBox["t", TraditionalForm]]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(49)"}, {None, None}}], 
  Cell[BoxData[RowBox[{RowBox[{SubscriptBox[FormBox["e", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"-", RowBox[{SubscriptBox[FormBox["e", TraditionalForm], 
             RowBox[{FormBox["t", TraditionalForm], RowBox[{"-", 
                 "1"}]}]]}]}]}], "=", 
      RowBox[{RowBox[{FormBox["\[Beta]", TraditionalForm], "\[ThinSpace]", 
          RowBox[{SubscriptBox["\[DoubleStruckCapitalE]", FormBox["t", 
              TraditionalForm]], "[", RowBox[{SubscriptBox[FormBox["e", 
                TraditionalForm], RowBox[{FormBox["t", TraditionalForm], 
                 RowBox[{"+", "1"}]}]], RowBox[{"-", RowBox[{SubscriptBox[
                   FormBox["e", TraditionalForm], FormBox["t", 
                    TraditionalForm]]}]}]}], "]"}]}], 
        RowBox[{"+", RowBox[{FormBox[SubscriptBox["\[Kappa]", "e"], 
             TraditionalForm], "\[ThinSpace]", RowBox[
             {"(", RowBox[{SubscriptBox[FormBox["n", TraditionalForm], 
                 FormBox["t", TraditionalForm]], RowBox[{"-", RowBox[
                   {SubscriptBox[FormBox["e", TraditionalForm], FormBox["t", 
                      TraditionalForm]]}]}]}], ")"}]}]}]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(50)"}, {None, None}}], 
  Cell[BoxData[RowBox[{FormBox[SubscriptBox["\[Kappa]", "e"], 
       TraditionalForm], "=", FractionBox[
       RowBox[{RowBox[{RowBox[{"(", RowBox[{"1", RowBox[{"-", RowBox[
                  {FormBox[SubscriptBox["\[Theta]", "e"], TraditionalForm], 
                   "\[ThinSpace]", FormBox["\[Beta]", TraditionalForm]}]}]}], 
             ")"}], "\[ThinSpace]", RowBox[{"(", RowBox[{"1", RowBox[
                {"-", RowBox[{FormBox[SubscriptBox["\[Theta]", "e"], 
                    TraditionalForm]}]}]}], ")"}]}]}], 
       RowBox[{FormBox[SubscriptBox["\[Theta]", "e"], TraditionalForm]}]]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(51)"}, {None, None}}], 
  Cell["Employment adjusts gradually towards hours demanded. The relationship \
l=u+e uses the model's linear normalisation; it is not the exact level \
unemployment identity without an appropriate conversion. These labour-market \
mechanisms are inherited across the three versions.", "Text"], 
  Cell["4.3 Monetary policy and the domestic Phillips curve", "Subsection"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["r", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{RowBox[{FormBox[SubscriptBox["\[Rho]", "R"], TraditionalForm], 
          "\[ThinSpace]", SubscriptBox[FormBox["r", TraditionalForm], 
           RowBox[{FormBox["t", TraditionalForm], RowBox[{"-", "1"}]}]]}], 
        RowBox[{"+", RowBox[{RowBox[{"(", RowBox[{"1", RowBox[{"-", 
                  RowBox[{FormBox[SubscriptBox["\[Rho]", "R"], 
                     TraditionalForm]}]}]}], ")"}], "\[ThinSpace]", 
            RowBox[{"(", RowBox[{RowBox[{FormBox[SubscriptBox["\[Phi]", 
                    "\[Pi]"], TraditionalForm], "\[ThinSpace]", SubscriptBox[
                   FormBox[TemplateBox[{"\[Pi]", "target"}, "Superscript", 
                     SyntaxForm -> SuperscriptBox], TraditionalForm], 
                   FormBox["t", TraditionalForm]]}], RowBox[{"+", 
                  RowBox[{FormBox[SubscriptBox["\[Phi]", "y"], 
                     TraditionalForm], "\[ThinSpace]", SubscriptBox[
                     FormBox["gap", TraditionalForm], FormBox["t", 
                      TraditionalForm]]}]}], RowBox[{"+", RowBox[
                   {FormBox[SubscriptBox["\[Phi]", RowBox[{"\[CapitalDelta]", 
                        " ", "y"}]], TraditionalForm], "\[ThinSpace]", 
                    RowBox[{"(", RowBox[{SubscriptBox[FormBox["gap", 
                          TraditionalForm], FormBox["t", TraditionalForm]], 
                        RowBox[{"-", RowBox[{SubscriptBox[FormBox["gap", 
                          TraditionalForm], RowBox[{FormBox["t", 
                          TraditionalForm], RowBox[{"-", "1"}]}]]}]}]}], 
                      ")"}]}]}]}], ")"}]}]}], 
        RowBox[{"-", RowBox[{SubscriptBox[FormBox[SubscriptBox["\[Epsilon]", 
               "r"], TraditionalForm], FormBox["t", 
              TraditionalForm]]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(52)"}, {None, None}}], 
  Cell["Classic sets piTarget=pi; both sectoral versions set piTarget=piC. \
This is an explicit policy choice. The negative sign on epsilonr is retained: \
a positive innovation to that process reduces r directly. The domestic price \
Phillips curve continues to use domestic inflation and domestic-real marginal \
cost.", "Text"], Cell["What sticky prices and a Phillips curve assume", 
   "Subsection"], Cell["Price rigidity gives a firm a reason to care about \
future costs when choosing today's price. If a price may remain in place for \
several periods, the firm must weigh a sequence of expected demand and cost \
conditions. In a constant-hazard Calvo interpretation, thetaP is the \
probability of not reoptimising the price in a period. The expected time \
between reoptimisations is 1/(1\[Minus]thetaP). For example, thetaP=0.75 \
corresponds to four quarters. This is an average waiting time, not a rule \
that every firm changes its price exactly once a year.", "Text"], 
  Cell["The parameter gammaP represents indexation of a non-reoptimised price \
to past inflation. This introduces lagged inflation, whereas forward-looking \
price setting introduces expected future inflation. The Phillips curve \
summarises these forces around the reference equilibrium. Its slope kappaP \
translates a marginal-cost deviation into inflation pressure. Greater \
rigidity reduces the frequency of resetting and, under the maintained \
formula, tends to flatten that relationship.", "Text"], 
  Cell["A markup is the price charged relative to marginal cost. It reflects \
product-market structure and demand elasticity; it is not the same as a fixed \
cost or a wedge in household purchasing power. The present calibration \
connects a steady markup factor with a fixed-cost/output normalisation, but \
the concepts remain distinct. A domestic Phillips curve governs domestic \
producer prices. Imported energy and food prices are instead driven by \
exogenous relative-price laws, so CPI combines domestic price setting with \
imported-price movements.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{SubscriptBox[FormBox["\[Pi]", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"-", RowBox[{FormBox[SubscriptBox["\[Gamma]", 
              StyleBox["P", FontSlant -> Italic, StripOnInput -> False]], 
             TraditionalForm], "\[ThinSpace]", SubscriptBox[FormBox["\[Pi]", 
              TraditionalForm], RowBox[{FormBox["t", TraditionalForm], RowBox[
                {"-", "1"}]}]]}]}]}], "=", 
      RowBox[{RowBox[{FormBox["\[Beta]", TraditionalForm], "\[ThinSpace]", 
          RowBox[{SubscriptBox["\[DoubleStruckCapitalE]", FormBox["t", 
              TraditionalForm]], "[", RowBox[{SubscriptBox[FormBox["\[Pi]", 
                TraditionalForm], RowBox[{FormBox["t", TraditionalForm], 
                 RowBox[{"+", "1"}]}]], RowBox[{"-", RowBox[
                 {FormBox[SubscriptBox["\[Gamma]", StyleBox["P", FontSlant -> 
                      Italic, StripOnInput -> False]], TraditionalForm], 
                  "\[ThinSpace]", SubscriptBox[FormBox["\[Pi]", 
                    TraditionalForm], FormBox["t", TraditionalForm]]}]}]}], 
            "]"}]}], RowBox[{"+", RowBox[{FormBox[SubscriptBox["\[Kappa]", 
              StyleBox["P", FontSlant -> Italic, StripOnInput -> False]], 
             TraditionalForm], "\[ThinSpace]", SubscriptBox[
             FormBox["mc", TraditionalForm], FormBox["t", 
              TraditionalForm]]}]}], RowBox[
         {"-", RowBox[{"100", "\[ThinSpace]", FormBox[SubscriptBox[
              "\[Kappa]", StyleBox["P", FontSlant -> Italic, StripOnInput -> 
                False]], TraditionalForm], "\[ThinSpace]", 
            SubscriptBox[FormBox[SubscriptBox["\[Epsilon]", "p"], 
              TraditionalForm], FormBox["t", TraditionalForm]]}]}]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(53)"}, {None, None}}], 
  Cell[BoxData[RowBox[{FormBox[SubscriptBox["\[Kappa]", 
        StyleBox["P", FontSlant -> Italic, StripOnInput -> False]], 
       TraditionalForm], "=", FractionBox[
       RowBox[{RowBox[{RowBox[{"(", RowBox[{"1", RowBox[{"-", RowBox[
                  {FormBox[SubscriptBox["\[Theta]", StyleBox["P", 
                      FontSlant -> Italic, StripOnInput -> False]], 
                    TraditionalForm], "\[ThinSpace]", FormBox["\[Beta]", 
                    TraditionalForm]}]}]}], ")"}], "\[ThinSpace]", 
           RowBox[{"(", RowBox[{"1", RowBox[{"-", RowBox[{FormBox[
                    SubscriptBox["\[Theta]", StyleBox["P", FontSlant -> 
                       Italic, StripOnInput -> False]], 
                    TraditionalForm]}]}]}], ")"}]}]}], 
       RowBox[{RowBox[{FormBox[SubscriptBox["\[Theta]", StyleBox["P", 
              FontSlant -> Italic, StripOnInput -> False]], TraditionalForm], 
           "\[ThinSpace]", RowBox[{"(", RowBox[{"1", RowBox[{"+", 
                 RowBox[{RowBox[{"(", RowBox[{FormBox[SubscriptBox["\[Psi]", 
                         StyleBox["P", FontSlant -> Italic, StripOnInput -> 
                          False]], TraditionalForm], RowBox[{"-", "1"}]}], 
                     ")"}], "\[ThinSpace]", FormBox[SubscriptBox[
                     "\[CurlyEpsilon]", StyleBox["P", FontSlant -> Italic, 
                      StripOnInput -> False]], TraditionalForm]}]}]}], 
             ")"}]}]}]]}]], "DisplayFormula", CellFrameLabels -> 
    {{None, "(54)"}, {None, None}}], Cell["This is the source expression \
\[Minus]pi2(\[Minus]mc+100epsilonp) rewritten to show its signs. \
cthetap=\[Theta]P, cgammap=\[Gamma]P, cepsp=epsP and cpsip=\[Psi]P. The \
price-aggregator curvature correction is inherited. Adding imported food does \
not add a domestic agricultural technology or a food Phillips curve.", 
   "Text"], Cell["5. Energy in production: derive the firm's cost equations", 
   "Section"], Cell["5.1 Production technology and the fixed cost", 
   "Subsection"], Cell["Energy in production is an intermediate input: firms \
buy it to produce something else. Household energy is final consumption: it \
delivers services directly to households. These uses share an import price \
here but play different economic roles. A production-energy shock changes the \
firm's feasible input mix and cost; a household-energy shock channel changes \
the cost of living. Keeping En and CE separate prevents these two mechanisms \
from being mixed in resource accounting.", "Text"], 
  Cell["The restriction alpha+nu<1 leaves a strictly positive labour \
elasticity alphaN. A positive energy exponent means energy is essential in \
this technology: with zero energy and positive weights, technological output \
is zero. If nu is set to zero, energy becomes unnecessary and the appropriate \
object is the reduced two-input technology. Increasing nu while holding alpha \
fixed reduces the labour exponent; it does not create increasing returns, \
since the exponent sum remains one.", "Text"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["X", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["A", TraditionalForm], 
         FormBox["t", TraditionalForm]], "\[ThinSpace]", 
        SuperscriptBox[SubscriptBox[FormBox[StyleBox["K", 
            FontSlant -> Italic, StripOnInput -> False], TraditionalForm], 
          FormBox["t", TraditionalForm]], FormBox["\[Alpha]", 
          TraditionalForm]], "\[ThinSpace]", SuperscriptBox[
         SubscriptBox[FormBox[StyleBox["N", FontSlant -> Italic, 
            StripOnInput -> False], TraditionalForm], FormBox["t", 
           TraditionalForm]], FormBox[SubscriptBox["\[Alpha]", 
           StyleBox["N", FontSlant -> Italic, StripOnInput -> False]], 
          TraditionalForm]], "\[ThinSpace]", SuperscriptBox[
         SubscriptBox[FormBox[SubscriptBox[StyleBox["E", FontSlant -> Plain, 
             StripOnInput -> False], "n"], TraditionalForm], 
          FormBox["t", TraditionalForm]], FormBox["\[Nu]", 
          TraditionalForm]]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(55)"}, {None, None}}], 
  Cell[BoxData[RowBox[{FormBox[SubscriptBox["\[Alpha]", 
        StyleBox["N", FontSlant -> Italic, StripOnInput -> False]], 
       TraditionalForm], "=", 
      RowBox[{"1", RowBox[{"-", RowBox[{FormBox["\[Alpha]", 
             TraditionalForm]}]}], RowBox[
         {"-", RowBox[{FormBox["\[Nu]", TraditionalForm]}]}]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(56)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["Y", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["X", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"-", RowBox[{FormBox["\[CapitalPhi]", 
             TraditionalForm]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(57)"}, {None, None}}], 
  Cell["Assume \[Alpha]>0, \[Nu]>0, \[Alpha]+\[Nu]<1, A>0 and positive \
inputs. The exponents sum to one, giving constant returns to scale. Each \
input has a positive, decreasing own marginal product: for instance \
\[PartialD]X/\[PartialD]En=\[Nu]X/En. Positive cross derivatives express \
technological complementarity, while cost-driven substitution still has \
elasticity one.", "Text"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["y", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{FormBox[SubscriptBox["\[Psi]", StyleBox["P", 
           FontSlant -> Italic, StripOnInput -> False]], TraditionalForm], 
        "\[ThinSpace]", RowBox[{"(", RowBox[{SubscriptBox[FormBox["a", 
              TraditionalForm], FormBox["t", TraditionalForm]], 
            RowBox[{"+", RowBox[{FormBox["\[Alpha]", TraditionalForm], 
                "\[ThinSpace]", SubscriptBox[FormBox["k", TraditionalForm], 
                 FormBox["t", TraditionalForm]]}]}], 
            RowBox[{"+", RowBox[{FormBox[SubscriptBox["\[Alpha]", 
                  StyleBox["N", FontSlant -> Italic, StripOnInput -> False]], 
                 TraditionalForm], "\[ThinSpace]", SubscriptBox[FormBox["n", 
                  TraditionalForm], FormBox["t", TraditionalForm]]}]}], 
            RowBox[{"+", RowBox[{FormBox["\[Nu]", TraditionalForm], 
                "\[ThinSpace]", SubscriptBox[FormBox[SubscriptBox[StyleBox[
                    "e", Italic, StripOnInput -> False], "n"], 
                  TraditionalForm], FormBox["t", TraditionalForm]]}]}]}], 
          ")"}]}]}]], "DisplayFormula", CellFrameLabels -> 
    {{None, "(58)"}, {None, None}}], 
  Cell["5.2 Cost minimisation and the dual function", "Subsection"], 
  Cell["For a given technological output X, minimise \
RK\[CenterDot]K+W\[CenterDot]N+PE\[CenterDot]En subject to A K^\[Alpha] \
N^\[Alpha]N En^\[Nu]\[GreaterEqual]X. Divide all prices and the nominal \
multiplier by PD. The resulting real factor prices are rK, wD and \
pElevel=PE/PD; m is the real marginal cost in domestic goods. The binding \
production constraint and the three FOCs give:", "Text"], 
  Cell["Marginal cost is the minimum additional expenditure needed to produce \
a small extra unit of output, holding prices and technology fixed. The \
multiplier on the production target has exactly that interpretation: relaxing \
the requirement by one unit changes the minimum cost by the multiplier. This \
is why the same m appears in all three input conditions. At an interior \
optimum, spending one more unit on any input must buy the same additional \
output after valuing it at marginal cost.", "Text"], 
  Cell["Strictly positive factor prices rule out obtaining unlimited amounts \
of an input at no cost. A positive production target and essential \
positive-weight inputs rule out a zero-input corner. Concavity of the \
Cobb-Douglas technology makes its production-superlevel feasible set convex, \
while expenditure is linear. Under these assumptions the cost FOCs \
characterise a global cost minimum, rather than merely an arbitrary \
stationary point. These assumptions justify dividing the conditions by \
positive inputs and using logarithms later.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{SubscriptBox[FormBox[SubscriptBox["r", StyleBox["K", 
            FontSlant -> Italic, StripOnInput -> False]], TraditionalForm], 
         FormBox["t", TraditionalForm]], "\[ThinSpace]", 
        SubscriptBox[FormBox[StyleBox["K", FontSlant -> Italic, 
           StripOnInput -> False], TraditionalForm], FormBox["t", 
          TraditionalForm]]}], "=", 
      RowBox[{FormBox["\[Alpha]", TraditionalForm], "\[ThinSpace]", 
        SubscriptBox[FormBox["m", TraditionalForm], FormBox["t", 
          TraditionalForm]], "\[ThinSpace]", SubscriptBox[
         FormBox["X", TraditionalForm], FormBox["t", TraditionalForm]]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(59)"}, {None, None}}], 
  Cell[BoxData[RowBox[
     {RowBox[{SubscriptBox[FormBox[SubscriptBox["w", StyleBox["D", 
            FontSlant -> Plain, StripOnInput -> False]], TraditionalForm], 
         FormBox["t", TraditionalForm]], "\[ThinSpace]", 
        SubscriptBox[FormBox[StyleBox["N", FontSlant -> Italic, 
           StripOnInput -> False], TraditionalForm], FormBox["t", 
          TraditionalForm]]}], "=", 
      RowBox[{FormBox[SubscriptBox["\[Alpha]", StyleBox["N", 
           FontSlant -> Italic, StripOnInput -> False]], TraditionalForm], 
        "\[ThinSpace]", SubscriptBox[FormBox["m", TraditionalForm], 
         FormBox["t", TraditionalForm]], "\[ThinSpace]", 
        SubscriptBox[FormBox["X", TraditionalForm], FormBox["t", 
          TraditionalForm]]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(60)"}, {None, None}}], 
  Cell[BoxData[RowBox[
     {RowBox[{SubscriptBox[FormBox[TemplateBox[{SubscriptBox["p", 
             StyleBox["E", FontSlant -> Plain, StripOnInput -> False]], 
            "level"}, "Superscript", SyntaxForm -> SuperscriptBox], 
          TraditionalForm], FormBox["t", TraditionalForm]], "\[ThinSpace]", 
        SubscriptBox[FormBox[SubscriptBox[StyleBox["E", FontSlant -> Plain, 
            StripOnInput -> False], "n"], TraditionalForm], 
         FormBox["t", TraditionalForm]]}], "=", 
      RowBox[{FormBox["\[Nu]", TraditionalForm], "\[ThinSpace]", 
        SubscriptBox[FormBox["m", TraditionalForm], FormBox["t", 
          TraditionalForm]], "\[ThinSpace]", SubscriptBox[
         FormBox["X", TraditionalForm], FormBox["t", TraditionalForm]]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(61)"}, {None, None}}], 
  Cell["Multiply each marginal product by its input and add. Euler's theorem \
gives X, so total variable cost equals mX. Substitute K=\[Alpha]mX/rK, \
N=\[Alpha]N mX/wD and En=\[Nu]mX/pElevel into the technology; cancel X>0 and \
use the sum of shares equal to one. Solving for m gives:", "Text"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["m", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{FractionBox[RowBox[{"1"}], 
         RowBox[{SubscriptBox[FormBox["A", TraditionalForm], 
            FormBox["t", TraditionalForm]]}]], "\[ThinSpace]", 
        SuperscriptBox[RowBox[{"(", FractionBox[RowBox[
             {SubscriptBox[FormBox[SubscriptBox["r", StyleBox["K", 
                  FontSlant -> Italic, StripOnInput -> False]], 
                TraditionalForm], FormBox["t", TraditionalForm]]}], 
            RowBox[{FormBox["\[Alpha]", TraditionalForm]}]], ")"}], 
         FormBox["\[Alpha]", TraditionalForm]], "\[ThinSpace]", 
        SuperscriptBox[RowBox[{"(", FractionBox[RowBox[
             {SubscriptBox[FormBox[SubscriptBox["w", StyleBox["D", 
                  FontSlant -> Plain, StripOnInput -> False]], 
                TraditionalForm], FormBox["t", TraditionalForm]]}], 
            RowBox[{FormBox[SubscriptBox["\[Alpha]", StyleBox["N", 
                 FontSlant -> Italic, StripOnInput -> False]], 
               TraditionalForm]}]], ")"}], FormBox[SubscriptBox["\[Alpha]", 
           StyleBox["N", FontSlant -> Italic, StripOnInput -> False]], 
          TraditionalForm]], "\[ThinSpace]", SuperscriptBox[
         RowBox[{"(", FractionBox[RowBox[{SubscriptBox[FormBox[TemplateBox[
                 {SubscriptBox["p", StyleBox["E", FontSlant -> Plain, 
                    StripOnInput -> False]], "level"}, "Superscript", 
                 SyntaxForm -> SuperscriptBox], TraditionalForm], FormBox[
                "t", TraditionalForm]]}], RowBox[{FormBox["\[Nu]", 
               TraditionalForm]}]], ")"}], FormBox["\[Nu]", 
          TraditionalForm]]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(62)"}, {None, None}}], 
  Cell["Now take logarithms and subtract the steady state. Alternatively, \
divide the capital FOC by the labour FOC to eliminate m and X; its fixed \
share constant disappears in log deviations. Finally, take logs of the energy \
FOC and replace x by y/\[Psi]P. This yields equations 14, 16 and 15 of both \
sectoral files:", "Text"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["mc", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{RowBox[{FormBox[SubscriptBox["\[Alpha]", StyleBox["N", 
             FontSlant -> Italic, StripOnInput -> False]], TraditionalForm], 
          "\[ThinSpace]", SubscriptBox[FormBox["w", TraditionalForm], 
           FormBox["t", TraditionalForm]]}], 
        RowBox[{"+", RowBox[{FormBox["\[Alpha]", TraditionalForm], 
            "\[ThinSpace]", SubscriptBox[FormBox[SubscriptBox[StyleBox["r", 
                Italic, StripOnInput -> False], "K"], TraditionalForm], 
             FormBox["t", TraditionalForm]]}]}], 
        RowBox[{"+", RowBox[{FormBox["\[Nu]", TraditionalForm], 
            "\[ThinSpace]", SubscriptBox[FormBox[SubscriptBox["p", StyleBox[
                "E", FontSlant -> Plain, StripOnInput -> False]], 
              TraditionalForm], FormBox["t", TraditionalForm]]}]}], 
        RowBox[{"-", RowBox[{SubscriptBox[FormBox["a", TraditionalForm], 
             FormBox["t", TraditionalForm]]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(63)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["k", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["w", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"-", RowBox[{SubscriptBox[FormBox[SubscriptBox[StyleBox["r", 
                Italic, StripOnInput -> False], "K"], TraditionalForm], 
             FormBox["t", TraditionalForm]]}]}], 
        RowBox[{"+", SubscriptBox[FormBox["n", TraditionalForm], 
           FormBox["t", TraditionalForm]]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(64)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[SubscriptBox[
         StyleBox["e", Italic, StripOnInput -> False], "n"], 
        TraditionalForm], FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["mc", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"+", FractionBox[RowBox[{SubscriptBox[FormBox["y", 
               TraditionalForm], FormBox["t", TraditionalForm]]}], 
           RowBox[{FormBox[SubscriptBox["\[Psi]", StyleBox["P", FontSlant -> 
                 Italic, StripOnInput -> False]], TraditionalForm]}]]}], 
        RowBox[{"-", RowBox[{SubscriptBox[FormBox[SubscriptBox["p", StyleBox[
                "E", FontSlant -> Plain, StripOnInput -> False]], 
              TraditionalForm], FormBox["t", TraditionalForm]]}]}]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(65)"}, {None, None}}], 
  Cell["The energy FOC contains X, not Y. Omitting 1/cpsip would mix \
technological and after-fixed-cost output. Holding wages, rentals and \
productivity fixed, an energy relative-price increase raises marginal cost by \
\[Nu] times its log change. An equilibrium response also includes adjustments \
of all other endogenous variables.", "Text"], 
  Cell["5.3 Scale is not determined by the input FOCs alone", "Subsection"], 
  Cell["With a fixed product price and constant returns, profit after cost \
minimisation is (PD\[Minus]MCnom)X\[Minus]PD\[CapitalPhi]. Without demand or \
market clearing, a positive unit margin implies unbounded scale; equality of \
unit price and variable cost leaves scale undetermined. The cost problem \
identifies the input mix for a given production target. The sticky-price \
product-demand and price-setting problems determine its scale. One should \
distinguish technology, input choice and price choice.", "Text"], 
  Cell["6. Import financing, domestic resources and GDP", "Section"], 
  Cell["6.1 The energy-only closure", "Subsection"], 
  Cell["Exports of the domestic good finance imports period by period. There \
is no independently evolving foreign-asset position, exchange-rate equation \
or foreign demand schedule in this closure. EX is the domestic export volume. \
Energy used by firms and households faces the same imported price.", "Text"], 
  Cell["A trade closure tells the model how an import bill is financed. In \
this implementation the bill is paid immediately with exports. A more general \
open-economy model could let the country borrow abroad, use accumulated \
foreign assets, change its exchange rate, or face a foreign export-demand \
schedule. None of those alternatives is automatically present here. The \
balanced-trade assumption is simple and transparent, but can strongly \
influence the response of domestic output to an imported-price shock.", 
   "Text"], Cell["For example, a higher imported energy price tends to raise \
the value of a given import volume. Households and firms adjust their \
volumes, while the closure requires enough domestic exports to finance the \
resulting bill. This extra domestic use interacts with declining household \
purchasing power and higher production costs. It explains why one cannot \
deduce the sign of GDP by reading the energy cost term alone.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{SubscriptBox[FormBox[SubscriptBox[StyleBox["P", 
            FontSlant -> Italic, StripOnInput -> False], StyleBox["D", 
            FontSlant -> Plain, StripOnInput -> False]], TraditionalForm], 
         FormBox["t", TraditionalForm]], "\[ThinSpace]", 
        SubscriptBox[FormBox[StyleBox["EX", Plain, StripOnInput -> False], 
          TraditionalForm], FormBox["t", TraditionalForm]]}], "=", 
      RowBox[{SubscriptBox[FormBox[SubscriptBox[StyleBox["P", 
            FontSlant -> Italic, StripOnInput -> False], StyleBox["E", 
            FontSlant -> Plain, StripOnInput -> False]], TraditionalForm], 
         FormBox["t", TraditionalForm]], "\[ThinSpace]", 
        RowBox[{"(", RowBox[{SubscriptBox[FormBox[SubscriptBox[StyleBox["E", 
                FontSlant -> Plain, StripOnInput -> False], "n"], 
              TraditionalForm], FormBox["t", TraditionalForm]], 
            RowBox[{"+", SubscriptBox[FormBox[SubscriptBox[StyleBox["C", 
                  FontSlant -> Italic, StripOnInput -> False], StyleBox["E", 
                  FontSlant -> Plain, StripOnInput -> False]], 
                TraditionalForm], FormBox["t", TraditionalForm]]}]}], 
          ")"}]}]}]], "DisplayFormula", CellFrameLabels -> 
    {{None, "(66)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["etot", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{RowBox[{FormBox[SubscriptBox["\[Theta]", "En"], 
           TraditionalForm], "\[ThinSpace]", SubscriptBox[
           FormBox[SubscriptBox[StyleBox["e", Italic, StripOnInput -> False], 
             "n"], TraditionalForm], FormBox["t", TraditionalForm]]}], 
        RowBox[{"+", RowBox[{FormBox[SubscriptBox["\[Theta]", "Ce"], 
             TraditionalForm], "\[ThinSpace]", SubscriptBox[
             FormBox[SubscriptBox[StyleBox["c", Italic, StripOnInput -> 
                 False], "E"], TraditionalForm], FormBox["t", 
              TraditionalForm]]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(67)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[StyleBox["ex", Italic, 
         StripOnInput -> False], TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox[SubscriptBox["p", StyleBox["E", 
            FontSlant -> Plain, StripOnInput -> False]], TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"+", SubscriptBox[FormBox["etot", TraditionalForm], 
           FormBox["t", TraditionalForm]]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(68)"}, {None, None}}], 
  Cell["The log approximation to a sum uses steady shares: \
\[Theta]En=En\:0304/(En\:0304+CE\:0304), \[Theta]Ce=1\[Minus]\[Theta]En. The \
same weights are energy-expenditure shares because both uses share a common \
price. Adding log changes without these weights would be incorrect. These are \
equations 10 and 11 in the energy-only file.", "Text"], 
  Cell["6.2 Add final imported food", "Subsection"], 
  Cell[BoxData[RowBox[
     {RowBox[{SubscriptBox[FormBox[SubscriptBox[StyleBox["P", 
            FontSlant -> Italic, StripOnInput -> False], StyleBox["D", 
            FontSlant -> Plain, StripOnInput -> False]], TraditionalForm], 
         FormBox["t", TraditionalForm]], "\[ThinSpace]", 
        SubscriptBox[FormBox[StyleBox["EX", Plain, StripOnInput -> False], 
          TraditionalForm], FormBox["t", TraditionalForm]]}], "=", 
      RowBox[{RowBox[{SubscriptBox[FormBox[SubscriptBox[StyleBox["P", 
              FontSlant -> Italic, StripOnInput -> False], StyleBox["E", 
              FontSlant -> Plain, StripOnInput -> False]], TraditionalForm], 
           FormBox["t", TraditionalForm]], "\[ThinSpace]", 
          RowBox[{"(", RowBox[{SubscriptBox[FormBox[SubscriptBox[
                 StyleBox["E", FontSlant -> Plain, StripOnInput -> False], 
                 "n"], TraditionalForm], FormBox["t", TraditionalForm]], 
              RowBox[{"+", SubscriptBox[FormBox[SubscriptBox[StyleBox["C", 
                    FontSlant -> Italic, StripOnInput -> False], StyleBox[
                    "E", FontSlant -> Plain, StripOnInput -> False]], 
                  TraditionalForm], FormBox["t", TraditionalForm]]}]}], 
            ")"}]}], RowBox[{"+", RowBox[{SubscriptBox[
             FormBox[SubscriptBox[StyleBox["P", FontSlant -> Italic, 
                StripOnInput -> False], StyleBox["F", FontSlant -> Plain, 
                StripOnInput -> False]], TraditionalForm], FormBox["t", 
              TraditionalForm]], "\[ThinSpace]", SubscriptBox[
             FormBox[SubscriptBox[StyleBox["C", FontSlant -> Italic, 
                StripOnInput -> False], StyleBox["F", FontSlant -> Plain, 
                StripOnInput -> False]], TraditionalForm], FormBox["t", 
              TraditionalForm]]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(69)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[StyleBox["ex", Italic, 
         StripOnInput -> False], TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{RowBox[{FormBox[SubscriptBox["\[Theta]", "XE"], 
           TraditionalForm], "\[ThinSpace]", 
          RowBox[{"(", RowBox[{SubscriptBox[FormBox[SubscriptBox["p", 
                 StyleBox["E", FontSlant -> Plain, StripOnInput -> False]], 
                TraditionalForm], FormBox["t", TraditionalForm]], 
              RowBox[{"+", SubscriptBox[FormBox["etot", TraditionalForm], 
                 FormBox["t", TraditionalForm]]}]}], ")"}]}], 
        RowBox[{"+", RowBox[{FormBox[SubscriptBox["\[Theta]", "XF"], 
             TraditionalForm], "\[ThinSpace]", RowBox[
             {"(", RowBox[{SubscriptBox[FormBox[SubscriptBox["p", StyleBox[
                    "F", FontSlant -> Plain, StripOnInput -> False]], 
                  TraditionalForm], FormBox["t", TraditionalForm]], 
                RowBox[{"+", SubscriptBox[FormBox[SubscriptBox[StyleBox["c", 
                      Italic, StripOnInput -> False], "F"], TraditionalForm], 
                   FormBox["t", TraditionalForm]]}]}], ")"}]}]}]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(70)"}, {None, None}}], 
  Cell["\[Theta]XE and \[Theta]XF are the steady energy and food VALUE shares \
in total import expenditure. Their sum is one when imports are positive. They \
differ from \[Theta]En and \[Theta]Ce, which divide only energy imports. Food \
equations 11 and 35 change export financing in the sticky and flexible \
economies. For zero components use zero weighted contributions and the \
reduced model; do not take logs of zero levels.", "Text"], 
  Cell["6.3 The domestic resource constraint", "Subsection"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["Y", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox[SubscriptBox[StyleBox["C", 
            FontSlant -> Italic, StripOnInput -> False], StyleBox["N", 
            FontSlant -> Italic, StripOnInput -> False]], TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"+", SubscriptBox[FormBox[StyleBox["I", Italic, 
             StripOnInput -> False], TraditionalForm], FormBox["t", 
            TraditionalForm]]}], RowBox[{"+", SubscriptBox[
           FormBox[StyleBox["UC", Plain, StripOnInput -> False], 
            TraditionalForm], FormBox["t", TraditionalForm]]}], 
        RowBox[{"+", SubscriptBox[FormBox[StyleBox["G", Italic, 
             StripOnInput -> False], TraditionalForm], FormBox["t", 
            TraditionalForm]]}], RowBox[{"+", SubscriptBox[
           FormBox[StyleBox["EX", Plain, StripOnInput -> False], 
            TraditionalForm], FormBox["t", TraditionalForm]]}]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(71)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["y", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{RowBox[{FormBox[SubscriptBox["s", "CN"], TraditionalForm], 
          "\[ThinSpace]", SubscriptBox[FormBox[SubscriptBox[
             StyleBox["c", Italic, StripOnInput -> False], "N"], 
            TraditionalForm], FormBox["t", TraditionalForm]]}], 
        RowBox[{"+", RowBox[{FormBox[SubscriptBox["s", "\[ImaginaryI]"], 
             TraditionalForm], "\[ThinSpace]", SubscriptBox[
             FormBox["i", TraditionalForm], FormBox["t", 
              TraditionalForm]]}]}], RowBox[
         {"+", RowBox[{FormBox[SubscriptBox["s", "V"], TraditionalForm], 
            "\[ThinSpace]", SubscriptBox[FormBox["v", TraditionalForm], 
             FormBox["t", TraditionalForm]]}]}], 
        RowBox[{"+", SubscriptBox[FormBox[SubscriptBox[StyleBox["g", Italic, 
              StripOnInput -> False], "contribution"], TraditionalForm], 
           FormBox["t", TraditionalForm]]}], 
        RowBox[{"+", RowBox[{FormBox[SubscriptBox["s", "X"], 
             TraditionalForm], "\[ThinSpace]", SubscriptBox[
             FormBox[StyleBox["ex", Italic, StripOnInput -> False], 
              TraditionalForm], FormBox["t", TraditionalForm]]}]}]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(72)"}, {None, None}}], 
  Cell["Domestic consumption, investment, utilisation costs, government and \
exports exhaust domestic output. Imported CE and CF are not separately added \
to domestic use: domestic exports finance them. Replacing CN by composite C \
without adjusting the accounting would misallocate imports.", "Text"], 
  Cell["6.4 Value added, not nominal import expenditure", "Subsection"], 
  Cell["Gross output and value added answer different questions. Gross output \
counts the value of the goods produced by domestic firms, including \
production that uses imported intermediate inputs. Value added asks how much \
production value is generated domestically after those intermediate inputs \
are removed. If a firm imports energy to produce a final good, counting the \
whole final good as domestic value added would attribute the imported energy \
contribution to the domestic economy as well.", "Text"], 
  Cell["Real and nominal value added must also be separated. A current-price \
import bill can rise because the input becomes more expensive even when its \
volume does not change. A quantity measure should not report that pure price \
increase as a drop in physical production. Double deflation therefore values \
output and intermediate-input volumes at specified base prices before taking \
the difference. The local first-order GDP equation is an implementation of \
that convention near the steady state, not a complete chain-linked \
national-accounts system for arbitrarily large changes.", "Text"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[TemplateBox[
         {StyleBox["GDP", Plain, StripOnInput -> False], "real"}, 
         "Superscript", SyntaxForm -> SuperscriptBox], TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["Y", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"-", RowBox[{FractionBox[RowBox[{FormBox["PEbase", 
                TraditionalForm]}], RowBox[{FormBox["PDbase", 
                TraditionalForm]}]], "\[ThinSpace]", SubscriptBox[
             FormBox[SubscriptBox[StyleBox["E", FontSlant -> Plain, 
                StripOnInput -> False], "n"], TraditionalForm], 
             FormBox["t", TraditionalForm]]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(73)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox["gdp", TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", FractionBox[
       RowBox[{RowBox[{"(", RowBox[{SubscriptBox[FormBox["y", 
               TraditionalForm], FormBox["t", TraditionalForm]], 
             RowBox[{"-", RowBox[{FormBox[SubscriptBox["s", "En"], 
                  TraditionalForm], "\[ThinSpace]", SubscriptBox[FormBox[
                   SubscriptBox[StyleBox["e", Italic, StripOnInput -> False], 
                    "n"], TraditionalForm], FormBox["t", 
                   TraditionalForm]]}]}]}], ")"}]}], 
       RowBox[{FormBox[SubscriptBox["s", "GDP"], TraditionalForm]}]]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(74)"}, {None, None}}], 
  Cell[BoxData[RowBox[{FormBox[SubscriptBox["s", "GDP"], TraditionalForm], 
      "=", RowBox[{"1", RowBox[{"-", RowBox[{FormBox[SubscriptBox["s", "En"], 
             TraditionalForm]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(75)"}, {None, None}}], 
  Cell["Equation 28 is a first-order double-deflation quantity measure: \
intermediate imported energy is subtracted at FIXED base prices. There is no \
contemporaneous pE term in this real GDP equation. Nominal current-price \
value added is different and contains a price contribution. Imported \
household energy and food are final consumption imports; subtracting them \
again from domestic value added would double count their subtraction. The \
expenditure-side identity gives the same GDP because exports finance final \
imports.", "Text"], Cell["Policy therefore uses gdp\[Minus]gdpf rather than \
y\[Minus]yf. Gross domestic production and domestic value added may respond \
differently to a commodity shock. Classic has sEn=0 and GDP=Y; the explicit \
distinction becomes necessary with the imported intermediate input.", 
   "Text"], Cell["7. Derive the steady-state shares and normalisations", 
   "Section"], Cell["Set steady PD=PE=1 and steady productivity to one. The \
sectoral calibration combines m\:0304=1/\[Psi]P with X\:0304/Y\:0304=\[Psi]P. \
Hence m\:0304X\:0304/Y\:0304=1. These normalisations, not the exponent alone, \
identify an output expenditure share with the production-energy elasticity.", 
   "Text"], Cell[BoxData[RowBox[{FormBox[SubscriptBox["s", "En"], 
       TraditionalForm], "=", FractionBox[
       RowBox[{RowBox[{FormBox[OverscriptBox[SubscriptBox[StyleBox["P", 
               FontSlant -> Italic, StripOnInput -> False], StyleBox["E", 
               FontSlant -> Plain, StripOnInput -> False]], "_"], 
            TraditionalForm], "\[ThinSpace]", FormBox[OverscriptBox[
             SubscriptBox[StyleBox["E", FontSlant -> Plain, StripOnInput -> 
                False], "n"], "_"], TraditionalForm]}]}], 
       RowBox[{RowBox[{FormBox[OverscriptBox[SubscriptBox[StyleBox["P", 
               FontSlant -> Italic, StripOnInput -> False], StyleBox["D", 
               FontSlant -> Plain, StripOnInput -> False]], "_"], 
            TraditionalForm], "\[ThinSpace]", FormBox[OverscriptBox["Y", 
             "_"], TraditionalForm]}]}]], "=", 
      RowBox[{FormBox["\[Nu]", TraditionalForm], "\[ThinSpace]", 
        FormBox[OverscriptBox["m", "_"], TraditionalForm], "\[ThinSpace]", 
        FractionBox[RowBox[{FormBox[OverscriptBox["X", "_"], 
            TraditionalForm]}], RowBox[{FormBox[OverscriptBox["Y", "_"], 
