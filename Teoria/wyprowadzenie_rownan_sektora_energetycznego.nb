   CellFrameLabels -> {{None, "(34)"}, {None, None}}], 
  Cell["Normalising quantities by their weights removes constant share \
factors from the dual price index. Such constants disappear in log deviations \
but matter for level derivations. The level symbol CF for food must not be \
confused with Dynare cf, which means total flexible-price consumption; food \
is cfood in the code.", "Text"], 
  Cell["3.2 Log deviations and the two-good reduction", "Subsection"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[SubscriptBox["p", 
         StyleBox["C", FontSlant -> Italic, StripOnInput -> False]], 
        TraditionalForm], FormBox["t", TraditionalForm]], "=", 
      RowBox[{RowBox[{FormBox[SubscriptBox["\[Omega]", StyleBox["E", 
             FontSlant -> Plain, StripOnInput -> False]], TraditionalForm], 
          "\[ThinSpace]", SubscriptBox[FormBox[SubscriptBox["p", 
             StyleBox["E", FontSlant -> Plain, StripOnInput -> False]], 
            TraditionalForm], FormBox["t", TraditionalForm]]}], 
        RowBox[{"+", RowBox[{FormBox[SubscriptBox["\[Omega]", 
              StyleBox["F", FontSlant -> Plain, StripOnInput -> False]], 
             TraditionalForm], "\[ThinSpace]", SubscriptBox[
             FormBox[SubscriptBox["p", StyleBox["F", FontSlant -> Plain, 
                StripOnInput -> False]], TraditionalForm], FormBox["t", 
              TraditionalForm]]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(35)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[SubscriptBox[
