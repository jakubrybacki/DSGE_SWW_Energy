             TraditionalForm]}]}], RowBox[
         {"-", RowBox[{FormBox["\[Nu]", TraditionalForm]}]}]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(82)"}, {None, None}}], 
  Cell["The rental return follows from the deterministic capital Euler \
condition under the source's trend convention. Balanced-growth capital \
accumulation implies the investment ratio. Government expenditure is a share \
of GDP, so its share of domestic gross output is multiplied by \
1\[Minus]\[Nu]. sC is total household consumption expenditure divided by \
domestic output, not domestic consumption quantity by itself. The utilisation \
coefficient is the marginal utilisation expenditure divided by output.", 
   "Text"], Cell[BoxData[RowBox[{FormBox[SubscriptBox["s", "CN"], 
       TraditionalForm], "=", 
      RowBox[{RowBox[{"(", RowBox[{"1", RowBox[{"-", RowBox[{FormBox[
                 SubscriptBox["\[Omega]", StyleBox["E", FontSlant -> Plain, 
                   StripOnInput -> False]], TraditionalForm]}]}], 
            RowBox[{"-", RowBox[{FormBox[SubscriptBox["\[Omega]", 
                  StyleBox["F", FontSlant -> Plain, StripOnInput -> False]], 
                 TraditionalForm]}]}]}], ")"}], "\[ThinSpace]", 
        FormBox[SubscriptBox["s", StyleBox["C", FontSlant -> Italic, 
           StripOnInput -> False]], TraditionalForm]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(83)"}, {None, None}}], 
  Cell[BoxData[RowBox[{FormBox[SubscriptBox["s", "Ce"], TraditionalForm], 
      "=", RowBox[{FormBox[SubscriptBox["\[Omega]", StyleBox["E", 
           FontSlant -> Plain, StripOnInput -> False]], TraditionalForm], 
