        RowBox[{"-", RowBox[{RowBox[{"(", RowBox[{SubscriptBox[FormBox["z", 
                  TraditionalForm], FormBox["t", TraditionalForm]], 
                RowBox[{"+", SubscriptBox[FormBox[SubscriptBox["\[Epsilon]", 
                     "s"], TraditionalForm], FormBox["t", 
                    TraditionalForm]]}], RowBox[{"+", RowBox[
