         FormBox["u", TraditionalForm], FormBox["t", TraditionalForm]]}], 
      "=", RowBox[{SubscriptBox[FormBox[SubscriptBox["w", 
           StyleBox["C", FontSlant -> Italic, StripOnInput -> False]], 
