             StyleBox["E", FontSlant -> Plain, StripOnInput -> False]], 
            TraditionalForm], FormBox["t", TraditionalForm]]}], 
        RowBox[{"-", RowBox[{SubscriptBox[FormBox[SubscriptBox["p", StyleBox[
                "E", FontSlant -> Plain, StripOnInput -> False]], 
              TraditionalForm], RowBox[{FormBox["t", TraditionalForm], RowBox[
                {"-", "1"}]}]]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(41)"}, {None, None}}], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[TemplateBox[
         {"\[Pi]", StyleBox["F", FontSlant -> Plain, StripOnInput -> False]}, 
         "Superscript", SyntaxForm -> SuperscriptBox], TraditionalForm], 
       FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["\[Pi]", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"+", SubscriptBox[FormBox[SubscriptBox["p", 
             StyleBox["F", FontSlant -> Plain, StripOnInput -> False]], 
            TraditionalForm], FormBox["t", TraditionalForm]]}], 
        RowBox[{"-", RowBox[{SubscriptBox[FormBox[SubscriptBox["p", StyleBox[
                "F", FontSlant -> Plain, StripOnInput -> False]], 
              TraditionalForm], RowBox[{FormBox["t", TraditionalForm], RowBox[
                {"-", "1"}]}]]}]}]}]}]], "DisplayFormula", 
   CellFrameLabels -> {{None, "(42)"}, {None, None}}], 
  Cell["The sectoral consumption Euler equation uses expected piC, whereas \
capital valuation still uses expected pi. Replacing both deflators by CPI \
would change the units of the domestic investment payoff incorrectly.", 
   "Text"], Cell["4.2 Purchasing-power wages and the labour-market block", 
   "Subsection"], 
  Cell[BoxData[RowBox[{SubscriptBox[FormBox[SubscriptBox["w", 
         StyleBox["C", FontSlant -> Italic, StripOnInput -> False]], 
        TraditionalForm], FormBox["t", TraditionalForm]], "=", 
      RowBox[{SubscriptBox[FormBox["w", TraditionalForm], 
         FormBox["t", TraditionalForm]], 
        RowBox[{"-", RowBox[{SubscriptBox[FormBox[SubscriptBox["p", StyleBox[
                "C", FontSlant -> Italic, StripOnInput -> False]], 
              TraditionalForm], FormBox["t", TraditionalForm]]}]}]}]}]], 
   "DisplayFormula", CellFrameLabels -> {{None, "(43)"}, {None, None}}], 
  Cell[BoxData[RowBox[{RowBox[{FormBox[SubscriptBox["\[Omega]", "U"], 
