     Cell[CellGroupData[{Cell["First Order Conditions - Funkcja Produkcji", 
         "Section", CellChangeTimes -> {{3.9802506172788486*^9, 
            3.980250626862728*^9}}, ExpressionUUID -> 
          "69673263-b007-4450-a5a7-2e241f4db94d"], 
        Cell[TextData[{"W pierwszej kolejno\:015bci liczymy warunki \
pierwszego rz\:0119du - ", StyleBox["First Order Conditions (FOC).\n", 
            FontSlant -> "Italic"], "B\:0119dziemy chcieli zestawi\[CAcute] 3 \
produkty kra\:0144cowe czynnik\[OAcute]w produkcji z odpowiednim \
ograniczeniem bud\:017cetowym:  "}], "Text", CellChangeTimes -> 
          {{3.980246056346855*^9, 3.980246057184185*^9}, 
           {3.980246095397167*^9, 3.980246115454357*^9}, 
           {3.9802464101609592*^9, 3.980246421685089*^9}, 
           {3.980246633444002*^9, 3.9802466660278625*^9}, 
           {3.9802469949882145*^9, 3.9802469977151413*^9}}, 
         ExpressionUUID -> "5732d65e-f6bd-a643-8e46-cf0374502e26"], 
        Cell[CellGroupData[{Cell["Step 2 \[LongDash] Marginal product of \
capital. D[Y[t],K[t]] differentiates only with respect to capital. The power \
rule gives \
MPK=\[Alpha]A[t]K[t]^(\[Alpha]\[Minus]1)L[t]^(1\[Minus]\[Alpha]\[Minus]\[Nu])\
Ef[t]^\[Nu]=\[Alpha]Y[t]/K[t]. It is positive under our assumptions, and it \
declines as K[t] rises with the other inputs fixed.", "Text"], 
           Cell[BoxData[StyleBox[RowBox[{"MPK", " ", "=", " ", 
                RowBox[{"D", "[", RowBox[{RowBox[{"Y", "[", "t", "]"}], ",", 
                    " ", RowBox[{"K", "[", "t", "]"}]}], "]"}]}], 
              FontSlant -> "Italic"]], "Input", CellChangeTimes -> 
             {{3.9802464188761864*^9, 3.9802464188761864*^9}, 
              {3.980248518618372*^9, 3.9802485211515694*^9}, 
              {3.980250220820614*^9, 3.980250225481886*^9}}, 
            ExpressionUUID -> "10c13271-288a-4215-9e16-35c8460af594"], 
           Cell[BoxData[RowBox[{"\[Alpha]", " ", RowBox[{"A", "[", "t", 
                 "]"}], " ", SuperscriptBox[RowBox[{"Ef", "[", "t", "]"}], 
                "\[Nu]"], " ", SuperscriptBox[RowBox[{"K", "[", "t", "]"}], 
                RowBox[{RowBox[{"-", "1"}], "+", "\[Alpha]"}]], " ", 
               SuperscriptBox[RowBox[{"L", "[", "t", "]"}], RowBox[
                 {"1", "-", "\[Alpha]", "-", "\[Nu]"}]]}]], "Output", 
            CellLabel -> "Out[3]= ", ExpressionUUID -> 
             "92bae3d7-4fc7-46dc-8813-2a1b6b126dee"]}, Open]], 
        Cell[CellGroupData[{Cell["Step 3 \[LongDash] Marginal product of \
labour. Apply the same power rule to L[t]. The resulting \
MPL=(1\[Minus]\[Alpha]\[Minus]\[Nu])Y[t]/L[t] is positive because the labour \
exponent is positive. A smaller labour exponent means a smaller output \
elasticity with respect to labour, not necessarily a smaller marginal product \
at every possible allocation.", "Text"], Cell[BoxData[
             RowBox[{"MPL", "=", RowBox[{"D", "[", RowBox[{RowBox[{"Y", "[", 
                     "t", "]"}], ",", RowBox[{"L", "[", "t", "]"}]}], 
                 "]"}]}]], "Input", CellChangeTimes -> 
             {{3.980246073437332*^9, 3.980246075159975*^9}, 
              {3.9802465409687576*^9, 3.9802465495665283*^9}, 
              3.980248249476305*^9, {3.9802485264624157*^9, 
               3.9802485284659977*^9}, {3.9802502325283947*^9, 
               3.980250233814064*^9}}, ExpressionUUID -> 
             "8623ec64-044d-43ed-ade1-be6cc4f7f2ca"], 
           Cell[BoxData[RowBox[{RowBox[{"(", RowBox[{"1", "-", "\[Alpha]", 
                   "-", "\[Nu]"}], ")"}], " ", RowBox[{"A", "[", "t", "]"}], 
               " ", SuperscriptBox[RowBox[{"Ef", "[", "t", "]"}], "\[Nu]"], 
               " ", SuperscriptBox[RowBox[{"K", "[", "t", "]"}], "\[Alpha]"], 
               " ", SuperscriptBox[RowBox[{"L", "[", "t", "]"}], 
                RowBox[{RowBox[{"-", "\[Alpha]"}], "-", "\[Nu]"}]]}]], 
            "Output", CellLabel -> "Out[4]= ", ExpressionUUID -> 
             "bf62b36c-2e14-4096-9247-f7dbb78657e2"]}, Open]], 
        Cell[CellGroupData[{Cell["Step 4 \[LongDash] Marginal product of \
energy. Differentiation gives MPE=\[Nu]Y[t]/Ef[t]. Because 0<\[Nu]<1, \
increasing energy raises output at a decreasing rate when capital and labour \
are held fixed. This Ef[t] belongs to firms and must be distinguished from \
household energy Eh[t] below.", "Text"], Cell[BoxData[
             RowBox[{"MPE", "=", RowBox[{"D", "[", RowBox[{RowBox[{"Y", "[", 
                     "t", "]"}], ",", RowBox[{"Ef", "[", "t", "]"}]}], 
                 "]"}]}]], "Input", CellChangeTimes -> 
             {{3.9802465575619164*^9, 3.9802465604477825*^9}, 
              3.980248251238415*^9, {3.980248537557644*^9, 
               3.9802485392745743*^9}, {3.9802502369417877*^9, 
               3.9802502387881336*^9}, {3.980253864024729*^9, 
               3.980253864167469*^9}}, ExpressionUUID -> 
             "9051e3fa-7bf5-4e26-9182-bb81eb30c23d"], 
           Cell[BoxData[RowBox[{"\[Nu]", " ", RowBox[{"A", "[", "t", "]"}], 
               " ", SuperscriptBox[RowBox[{"Ef", "[", "t", "]"}], 
                RowBox[{RowBox[{"-", "1"}], "+", "\[Nu]"}]], " ", 
               SuperscriptBox[RowBox[{"K", "[", "t", "]"}], "\[Alpha]"], " ", 
               SuperscriptBox[RowBox[{"L", "[", "t", "]"}], RowBox[
                 {"1", "-", "\[Alpha]", "-", "\[Nu]"}]]}]], "Output", 
            CellLabel -> "Out[5]= ", ExpressionUUID -> 
             "644ac18c-e941-417b-b677-d50a81f1948d"]}, Open]], 
        Cell["Nasze ograniczenie bud\:017cetowe ma nast\:0119puj\:0105c\:0105 \
form\:0119: ", "Text", CellChangeTimes -> {{3.9802468213028507*^9, 
            3.9802468307469864*^9}}, ExpressionUUID -> 
          "e43bef68-12ca-424e-b9b6-f916eeb4f410"], 
        Cell[CellGroupData[{Cell["Step 5 \[LongDash] Construct the objective. \
Z[t] subtracts the payments for all three inputs from output revenue. The \
assignment = evaluates this expression immediately. The following derivatives \
therefore recover how real profit changes when the firm changes one input \
while treating factor prices as given.", "Text"], 
           Cell[BoxData[RowBox[{RowBox[{"Z", "[", "t", "]"}], "=", RowBox[
                {RowBox[{"Y", "[", "t", "]"}], "-", RowBox[
                  {RowBox[{"w", "[", "t", "]"}], "*", RowBox[{"L", "[", "t", 
                     "]"}]}], "-", RowBox[{RowBox[{"r", "[", "t", "]"}], "*", 
                   RowBox[{"K", "[", "t", "]"}]}], "-", RowBox[
                  {RowBox[{"pe", "[", "t", "]"}], "*", RowBox[{"Ef", "[", 
                     "t", "]"}]}]}]}]], "Input", CellChangeTimes -> 
             {{3.980246743378992*^9, 3.980246743378992*^9}, 
              {3.980246795676405*^9, 3.980246861707678*^9}, 
              3.980248208640644*^9, {3.980248543635004*^9, 
               3.9802485669275837*^9}, {3.9802502411510696*^9, 
               3.9802502550894012*^9}, {3.980253874576042*^9, 
               3.9802538746889267*^9}}, ExpressionUUID -> 
             "dbd5480f-2cb4-4959-8c7a-08e51159f278"], 
           Cell[BoxData[RowBox[{RowBox[{RowBox[{"A", "[", "t", "]"}], " ", 
                 SuperscriptBox[RowBox[{"Ef", "[", "t", "]"}], "\[Nu]"], " ", 
                 SuperscriptBox[RowBox[{"K", "[", "t", "]"}], "\[Alpha]"], 
                 " ", SuperscriptBox[RowBox[{"L", "[", "t", "]"}], 
                  RowBox[{"1", "-", "\[Alpha]", "-", "\[Nu]"}]]}], "-", 
               RowBox[{RowBox[{"Ef", "[", "t", "]"}], " ", RowBox[{"pe", "[", 
                   "t", "]"}]}], "-", RowBox[{RowBox[{"K", "[", "t", "]"}], 
                 " ", RowBox[{"r", "[", "t", "]"}]}], "-", RowBox[
                {RowBox[{"L", "[", "t", "]"}], " ", RowBox[{"w", "[", "t", 
                   "]"}]}]}]], "Output", CellLabel -> "Out[6]= ", 
            ExpressionUUID -> "cc190c73-fe2d-4b41-9589-126fa409d2d6"]}, 
          Open]], Cell["Do wyliczenia FOC wykonuje pochodne ograniczenia \
bud\:017cetowego i przyr\[OAcute]wnuje je do zera: \n\nFOC pokazuja \
wynagrodzenie czynnik\[OAcute]w produkcji. P\[LSlash]ace liczone na podstawie \
pochodnej po pracy:", "Text", CellChangeTimes -> {{3.980246986950325*^9, 
            3.980247025228632*^9}, {3.9802488304628735*^9, 
            3.9802488739913044*^9}}, ExpressionUUID -> 
          "dd2b7dd1-b482-2d4e-9ed9-aa5b05639af2"], 
        Cell[CellGroupData[{Cell["Step 6 \[LongDash] Solve the labour \
condition. D computes the derivative of profit, Simplify rewrites it, and \
Solve[...==0,w[t]] expresses the wage implied by the first-order condition. \
First selects the first returned list of replacement rules. The rule is \
stored in solFirmFOCL for later substitution with /..", "Text"], 
           Cell[BoxData[{RowBox[{RowBox[{"FirmFOCL", "=", RowBox[
                   {RowBox[{"D", "[", RowBox[{RowBox[{"Z", "[", "t", "]"}], 
                        ",", RowBox[{"L", "[", "t", "]"}]}], "]"}], " ", 
                    "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{"solFirmFOCL", "=", RowBox[{"First", "@", RowBox[
                   {"Solve", "[", RowBox[{RowBox[{"FirmFOCL", "==", "0"}], 
                      ",", RowBox[{"w", "[", "t", "]"}]}], "]"}]}]}]}], 
            "Input", CellChangeTimes -> {{3.980247037049431*^9, 
               3.980247044621315*^9}, {3.980247637612484*^9, 
               3.9802476672814693*^9}, 3.9802481424503574*^9, 
              {3.98024833082946*^9, 3.980248332385069*^9}, 
              3.9802483792670403*^9, {3.980248413146879*^9, 
               3.9802484302017975*^9}, {3.98024858129348*^9, 
               3.980248619541937*^9}, {3.9802487015092316*^9, 
               3.980248727819786*^9}, {3.9802487610607395*^9, 
               3.9802488015859203*^9}, {3.9802489058161755*^9, 
               3.9802489200756245*^9}, {3.980248957393545*^9, 
               3.9802489749098797*^9}, {3.980249049419445*^9, 
               3.980249050048315*^9}, {3.980249121985449*^9, 
               3.9802491234829865*^9}, {3.980249272452385*^9, 
               3.980249272780903*^9}, {3.9802493656167145*^9, 
               3.9802493721735783*^9}, {3.980250261198496*^9, 
               3.980250265447361*^9}, {3.980253877579973*^9, 
               3.980253896759695*^9}}, ExpressionUUID -> 
             "1241d671-3d1a-4e63-ac2a-ec366ca603b3"], 
           Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"w", "[", "t", "]"}], 
                 "\[Rule]", RowBox[{"-", RowBox[{"(", RowBox[{RowBox[
                        {"(", RowBox[{RowBox[{"-", "1"}], "+", "\[Alpha]", 
                          "+", "\[Nu]"}], ")"}], " ", RowBox[{"A", "[", "t", 
                         "]"}], " ", SuperscriptBox[RowBox[{"Ef", "[", "t", 
                          "]"}], "\[Nu]"], " ", SuperscriptBox[RowBox[
                         {"K", "[", "t", "]"}], "\[Alpha]"], " ", 
                       SuperscriptBox[RowBox[{"L", "[", "t", "]"}], RowBox[
                         {RowBox[{"-", "\[Alpha]"}], "-", "\[Nu]"}]]}], 
                     ")"}]}]}], "}"}]], "Output", CellLabel -> "Out[8]= ", 
            ExpressionUUID -> "c2bab18c-de16-42f4-9098-c9fe5975ab13"]}, 
          Open]], Cell["Stopa procentowa to wynagrodzenie kapita\[LSlash]u - \
liczymy przez:", "Text", CellChangeTimes -> {{3.9802488605697575*^9, 
            3.980248880522087*^9}}, ExpressionUUID -> 
          "994c7c3d-2a78-d54d-abc0-069aef3bcd2e"], 
        Cell[CellGroupData[{Cell["Step 7 \[LongDash] Solve the capital \
condition. The same sequence now differentiates with respect to K[t] and \
solves for its rental price. The replacement rule is stored in solFOCK. This \
is a static input-choice condition, rather than an intertemporal Euler \
equation for saving.", "Text"], Cell[BoxData[{RowBox[{RowBox[{"FirmFOCK", 
                  "=", RowBox[{RowBox[{"D", "[", RowBox[{RowBox[{"Z", "[", 
                          "t", "]"}], ",", RowBox[{"K", "[", "t", "]"}]}], 
                      "]"}], " ", "//", "Simplify"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{"solFOCK", "=", RowBox[
                 {"First", "@", RowBox[{"Solve", "[", RowBox[{RowBox[
                       {"FirmFOCK", "==", "0"}], ",", RowBox[{"r", "[", "t", 
                        "]"}]}], "]"}]}]}]}], "Input", CellChangeTimes -> 
             {{3.980248889449087*^9, 3.9802489036106815*^9}, 
              {3.980249391864958*^9, 3.9802493971533737*^9}, 
              {3.9802502830683575*^9, 3.9802502899802113*^9}, 
              {3.9802503965584717*^9, 3.980250410901985*^9}, 
              {3.9802539153091526*^9, 3.9802539206025143*^9}}, 
            ExpressionUUID -> "9d71bba5-5505-4e7f-a39c-a2ed406e61c1"], 
           Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"r", "[", "t", "]"}], 
                 "\[Rule]", RowBox[{"\[Alpha]", " ", RowBox[{"A", "[", "t", 
                     "]"}], " ", SuperscriptBox[RowBox[{"Ef", "[", "t", 
                      "]"}], "\[Nu]"], " ", SuperscriptBox[RowBox[{"K", "[", 
                      "t", "]"}], RowBox[{RowBox[{"-", "1"}], "+", 
                      "\[Alpha]"}]], " ", SuperscriptBox[RowBox[{"L", "[", 
                      "t", "]"}], RowBox[{"1", "-", "\[Alpha]", "-", 
                      "\[Nu]"}]]}]}], "}"}]], "Output", CellLabel -> 
             "Out[10]= ", ExpressionUUID -> 
             "4d44d490-ed6d-4638-ba7b-e4f3b9d4bc9d"]}, Open]], 
        Cell["Realna cena energii to wynagrodzenie za produkcj\:0119 w \
systemie energetycznym:", "Text", CellChangeTimes -> 
          {{3.9802495893265495*^9, 3.9802495915808754*^9}}, 
         ExpressionUUID -> "1712b31c-5bfc-9244-8047-50089ca61c7a"], 
        Cell[CellGroupData[{Cell["Step 8 \[LongDash] Solve the energy \
condition. The calculation differentiates with respect to Ef[t] and solves \
for pe[t]. Code note: this cell stores the energy-price rule in solFOCK, \
overwriting the capital rule from the previous cell. The present annotation \
leaves that original code unchanged; when revising the computation, a \
distinct name such as solFOCE would preserve both rules.", "Text"], 
           Cell[BoxData[{RowBox[{RowBox[{"FirmFOCE", "=", RowBox[
                   {RowBox[{"D", "[", RowBox[{RowBox[{"Z", "[", "t", "]"}], 
                        ",", RowBox[{"Ef", "[", "t", "]"}]}], "]"}], "//", 
                    "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{"solFOCK", "=", RowBox[{"First", "@", RowBox[
                   {"Solve", "[", RowBox[{RowBox[{"FirmFOCE", "==", "0"}], 
                      ",", RowBox[{"pe", "[", "t", "]"}]}], "]"}]}]}]}], 
            "Input", CellChangeTimes -> {{3.980249525768196*^9, 
               3.980249540016445*^9}, {3.9802502997703915*^9, 
               3.980250305398878*^9}, {3.980250421520626*^9, 
               3.9802504292928257*^9}, {3.9802539236145134*^9, 
               3.9802539345608025*^9}}, ExpressionUUID -> 
             "bdf44174-5143-45e4-a854-f1eb422f474a"], 
           Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"pe", "[", "t", "]"}], 
                 "\[Rule]", RowBox[{"\[Nu]", " ", RowBox[{"A", "[", "t", 
                     "]"}], " ", SuperscriptBox[RowBox[{"Ef", "[", "t", 
                      "]"}], RowBox[{RowBox[{"-", "1"}], "+", "\[Nu]"}]], 
                   " ", SuperscriptBox[RowBox[{"K", "[", "t", "]"}], 
                    "\[Alpha]"], " ", SuperscriptBox[RowBox[{"L", "[", "t", 
                      "]"}], RowBox[{"1", "-", "\[Alpha]", "-", 
                      "\[Nu]"}]]}]}], "}"}]], "Output", CellLabel -> 
             "Out[12]= ", ExpressionUUID -> 
             "c8592194-26ee-4b5c-93ca-250e1d06119e"]}, Open]]}, Open]], 
     Cell[CellGroupData[
       {Cell[
         "Funkcja u\:017cyteczno\:015bci gospodarstw domowych  - energia", 
         "Section", CellChangeTimes -> {{3.980250692943754*^9, 
            3.980250700276682*^9}, {3.980250814393503*^9, 
            3.980250823984577*^9}}, ExpressionUUID -> 
          "41bd3032-4c1a-4ccc-9cf2-75c52b23b386"], Cell["Potrzebujemy funkcji \
u\:017cyteczno\:015bci, kt\[OAcute]ra uwzglednia\[CAcute] bedzie istnienie \
sektora energetycznego.\nZaczynamy tak - energia jest w pewnym stopnoi \
wymagana do konsumpcji - tutaj liczymy jako CES: ", "Text", 
         CellChangeTimes -> {{3.980250862217804*^9, 3.980250882354471*^9}, 
           {3.9802513517374344*^9, 3.980251367070345*^9}, 
           {3.9802514873518295*^9, 3.9802514957662296*^9}, 
           {3.9802520805438004*^9, 3.980252102503767*^9}}, 
         ExpressionUUID -> "3b506933-da24-684c-aaa9-d1d7b9b185a8"], 
        Cell[CellGroupData[{Cell["Step 9 \[LongDash] Define preferences. \
Ct[t] combines two consumption goods through the CES formula. u[t] then \
applies CRRA utility to that composite and subtracts a work-disutility term. \
TraditionalForm only changes how the expression is displayed. Code note: the \
work term uses N[t], although the budget and production blocks use L[t]. N is \
also a built-in Wolfram symbol. Before deriving labour supply, this notation \
should be made consistent, for example by using L[t] in the work term.", 
            "Text"], Cell[BoxData[{RowBox[{RowBox[{"\[Rho]", "=", 
                  RowBox[{RowBox[{"(", RowBox[{"\[Sigma]", "-", "1"}], ")"}], 
                    "/", "\[Sigma]"}]}], ";"}], "\n", RowBox[{RowBox[
                 {RowBox[{"Ct", "[", "t", "]"}], ":=", RowBox[
                   {RowBox[{"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{"1", 
                          "-", "\[Omega]"}], ")"}], "*", RowBox[{RowBox[
                          {"Cne", "[", "t", "]"}], "^", "\[Rho]"}]}], "+", 
                        RowBox[{"\[Omega]", "*", RowBox[{RowBox[{"Eh", "[", 
                          "t", "]"}], "^", "\[Rho]"}]}]}], ")"}], "^", 
                    RowBox[{"(", RowBox[{"1", "/", "\[Rho]"}], ")"}]}]}], 
                ";"}], "\n", RowBox[{RowBox[{RowBox[{"u", "[", "t", "]"}], 
                  ":=", RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[
                          {RowBox[{"Ct", "[", "t", "]"}], "^", RowBox[{"(", 
                          RowBox[{"1", "-", "\[Gamma]"}], ")"}]}], "-", 
                          "1"}], ")"}], "/", RowBox[{"(", RowBox[{"1", "-", 
                          "\[Gamma]"}], ")"}]}], "-", RowBox[{"\[Chi]", "*", 
                      RowBox[{RowBox[{RowBox[{"N", "[", "t", "]"}], "^", 
                          RowBox[{"(", RowBox[{"1", "+", "\[Phi]"}], ")"}]}], 
                        "/", RowBox[{"(", RowBox[{"1", "+", "\[Phi]"}], 
                          ")"}]}]}]}]}], ";"}], "\n", RowBox[{RowBox[
                 {"u", "[", "t", "]"}], " ", "//", "TraditionalForm"}]}], 
            "Input", CellChangeTimes -> {{3.980251490433134*^9, 
               3.9802514935594387*^9}, {3.9802515350053673*^9, 
               3.980251612069172*^9}, {3.980251654079214*^9, 
               3.9802516610315533*^9}, {3.980251753003271*^9, 
               3.9802518411748867*^9}, {3.9802518727626934*^9, 
               3.980251879147541*^9}, {3.9802541245651665*^9, 
               3.9802541248885937*^9}, {3.980255002625042*^9, 
               3.980255004057148*^9}}, ExpressionUUID -> 
             "8086cd89-2581-4ca1-9a84-aebccde1f2c6"], 
           Cell[BoxData[FormBox[RowBox[{FractionBox[RowBox[{SuperscriptBox[
                    RowBox[{"(", SuperscriptBox[RowBox[{"(", RowBox[
                          {RowBox[{RowBox[{"(", RowBox[{"1", "-", 
                          "\[Omega]"}], ")"}], " ", SuperscriptBox[RowBox[
                          {"Cne", "(", "t", ")"}], FractionBox[RowBox[
                          {"\[Sigma]", "-", "1"}], "\[Sigma]"]]}], "+", 
                          RowBox[{"\[Omega]", " ", SuperscriptBox[RowBox[
                          {"Eh", "(", "t", ")"}], FractionBox[RowBox[
                          {"\[Sigma]", "-", "1"}], "\[Sigma]"]]}]}], ")"}], 
                       FractionBox["\[Sigma]", RowBox[{"\[Sigma]", "-", 
                          "1"}]]], ")"}], RowBox[{"1", "-", "\[Gamma]"}]], 
                   "-", "1"}], RowBox[{"1", "-", "\[Gamma]"}]], "-", 
                FractionBox[RowBox[{"\[Chi]", " ", SuperscriptBox["t", 
                    RowBox[{"\[Phi]", "+", "1"}]]}], RowBox[{"\[Phi]", "+", 
                   "1"}]]}], TraditionalForm]], "Output", 
            CellLabel -> "Out[16]//TraditionalForm= ", ExpressionUUID -> 
             "11487301-0c80-4559-9b28-19a8263995e6"]}, Open]], 
        Cell[
         "Gospodarstwa domowe maj\:0105 swoje ograniczenie bud\:017cetowe:", 
         "Text", CellChangeTimes -> {{3.980252114616228*^9, 
            3.980252123831539*^9}}, ExpressionUUID -> 
          "985f8566-b974-f848-bf9d-a0c2f9498f1f"], 
        Cell[CellGroupData[{Cell["Step 10 \[LongDash] Write the budget \
residual. The definition bc[t] puts expenditures on the positive side and \
incomes on the negative side; the equation to impose is bc[t]==0. Code note: \
r[t] now appears as a bond interest rate inside 1+r[t], whereas it denoted \
the capital rental price above. These should be separate symbols in a fully \
specified model. This cell also omits direct household capital income; that \
is consistent only with a suitable ownership and income-accounting \
convention, which the model must specify.", "Text"], 
           Cell[BoxData[{RowBox[{RowBox[{"bc", "[", "t", "]"}], ":=", 
                RowBox[{RowBox[{"Cne", "[", "t", "]"}], "+", RowBox[
                   {RowBox[{"pe", "[", "t", "]"}], " ", RowBox[{"Eh", "[", 
                      "t", "]"}]}], "+", RowBox[{"B", "[", RowBox[{"t", "+", 
                      "1"}], "]"}], "-", RowBox[{"(", RowBox[{RowBox[
                       {RowBox[{"w", "[", "t", "]"}], " ", RowBox[{"L", "[", 
                          "t", "]"}]}], "+", RowBox[{RowBox[{"(", RowBox[
                          {"1", "+", RowBox[{"r", "[", "t", "]"}]}], ")"}], 
                        " ", RowBox[{"B", "[", "t", "]"}]}], "+", RowBox[
                       {"Z", "[", "t", "]"}]}], ")"}]}]}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"bc", "[", "t", "]"}], 
                " ", "//", "TraditionalForm"}]}], "Input", CellChangeTimes -> 
             {{3.980254103344734*^9, 3.9802541368300056*^9}, 
              {3.9802541744061775*^9, 3.9802542053490906*^9}}, 
            ExpressionUUID -> "431b5642-a0ea-4028-b7c4-de33bfe2fa6f"], 
           Cell[BoxData[FormBox[RowBox[{RowBox[{"-", RowBox[
                   {RowBox[{"A", "(", "t", ")"}], " ", SuperscriptBox[
                     RowBox[{"Ef", "(", "t", ")"}], "\[Nu]"], " ", 
                    SuperscriptBox[RowBox[{"L", "(", "t", ")"}], RowBox[
                      {RowBox[{"-", "\[Alpha]"}], "-", "\[Nu]", "+", "1"}]], 
                    " ", SuperscriptBox[RowBox[{"K", "[", "t", "]"}], 
                     "\[Alpha]"]}]}], "+", RowBox[{RowBox[{"r", "(", "t", 
                    ")"}], " ", RowBox[{"K", "[", "t", "]"}]}], "-", 
                RowBox[{RowBox[{"B", "(", "t", ")"}], " ", RowBox[
                   {"(", RowBox[{RowBox[{"r", "(", "t", ")"}], "+", "1"}], 
                    ")"}]}], "+", RowBox[{"B", "(", RowBox[{"t", "+", "1"}], 
                  ")"}], "+", RowBox[{"Cne", "(", "t", ")"}], "+", 
                RowBox[{RowBox[{"Ef", "(", "t", ")"}], " ", RowBox[
                   {"pe", "(", "t", ")"}]}], "+", RowBox[{RowBox[{"Eh", "(", 
                    "t", ")"}], " ", RowBox[{"pe", "(", "t", ")"}]}]}], 
              TraditionalForm]], "Output", CellLabel -> 
             "Out[18]//TraditionalForm= ", ExpressionUUID -> 
             "c671e45a-53ec-4e5c-ab8a-a736da15f429"]}, Open]], 
        Cell["W tym momencie buduje Lagrangian:\[AliasDelimiter]", "Text", 
         CellChangeTimes -> {{3.980254269619608*^9, 3.980254278635353*^9}, 
           {3.9802543194850388*^9, 3.9802543200882416*^9}}, 
         ExpressionUUID -> "e871d5ac-f8df-c844-9b1c-d9fcea473763"], 
        Cell[CellGroupData[{Cell["Step 11 \[LongDash] Form the lifetime \
objective. Sum adds the discounted period contributions from t=0 to infinity. \
The constraint is entered as \[Lambda][t](\[Minus]bc[t]), consistent with the \
sign convention above. These formal expressions alone do not deliver a bond \
Euler equation or a transversality condition; both require the appropriate \
intertemporal variations and admissibility conditions.", "Text"], 
           Cell[BoxData[{RowBox[{RowBox[{"Lagrangian", "=", RowBox[
                   {"Sum", "[", RowBox[{RowBox[{RowBox[{"\[Beta]", "^", 
                          "t"}], " ", RowBox[{"(", RowBox[{RowBox[{"u", "[", 
                          "t", "]"}], "+", RowBox[{RowBox[{"\[Lambda]", "[", 
                          "t", "]"}], " ", RowBox[{"(", RowBox[{"-", RowBox[
                          {"bc", "[", "t", "]"}]}], ")"}]}]}], ")"}]}], ",", 
                      RowBox[{"{", RowBox[{"t", ",", "0", ",", "Infinity"}], 
                        "}"}]}], "]"}]}], ";"}], "\n", RowBox[{"Lagrangian", 
                " ", "//", "TraditionalForm"}], "\[IndentingNewLine]"}], 
            "Input", CellChangeTimes -> {{3.980254210773817*^9, 
               3.980254215336237*^9}, {3.9802543225296936*^9, 
               3.9802543582761497*^9}, 3.980254390086281*^9, 
              {3.9802545201884327*^9, 3.9802545514570084*^9}, 
              3.980255007346426*^9}, ExpressionUUID -> 
             "441eb391-c04c-4e9c-b251-ffd2efb454c7"], 
           Cell[BoxData[FormBox[RowBox[{UnderoverscriptBox["\[Sum]", 
                 RowBox[{"t", "=", "0"}], "\[Infinity]"], RowBox[
                 {SuperscriptBox["\[Beta]", "t"], " ", RowBox[{"(", 
                    RowBox[{RowBox[{RowBox[{"\[Lambda]", "(", "t", ")"}], 
                        " ", RowBox[{"(", RowBox[{RowBox[{RowBox[{"A", "(", 
                          "t", ")"}], " ", SuperscriptBox[RowBox[{"Ef", "(", 
                          "t", ")"}], "\[Nu]"], " ", SuperscriptBox[RowBox[
                          {"L", "(", "t", ")"}], RowBox[{RowBox[{"-", 
                          "\[Alpha]"}], "-", "\[Nu]", "+", "1"}]], " ", 
                          SuperscriptBox[RowBox[{"K", "[", "t", "]"}], 
                          "\[Alpha]"]}], "-", RowBox[{RowBox[{"r", "(", "t", 
                          ")"}], " ", RowBox[{"K", "[", "t", "]"}]}], "+", 
                          RowBox[{RowBox[{"B", "(", "t", ")"}], " ", RowBox[
                          {"(", RowBox[{RowBox[{"r", "(", "t", ")"}], "+", 
                          "1"}], ")"}]}], "-", RowBox[{"B", "(", RowBox[
                          {"t", "+", "1"}], ")"}], "-", RowBox[{"Cne", "(", 
                          "t", ")"}], "-", RowBox[{RowBox[{"Ef", "(", "t", 
                          ")"}], " ", RowBox[{"pe", "(", "t", ")"}]}], "-", 
                          RowBox[{RowBox[{"Eh", "(", "t", ")"}], " ", RowBox[
                          {"pe", "(", "t", ")"}]}]}], ")"}]}], "+", 
                      FractionBox[RowBox[{SuperscriptBox[RowBox[{"(", 
                          SuperscriptBox[RowBox[{"(", RowBox[{RowBox[{RowBox[
                          {"(", RowBox[{"1", "-", "\[Omega]"}], ")"}], " ", 
                          SuperscriptBox[RowBox[{"Cne", "(", "t", ")"}], 
                          FractionBox[RowBox[{"\[Sigma]", "-", "1"}], 
                          "\[Sigma]"]]}], "+", RowBox[{"\[Omega]", " ", 
                          SuperscriptBox[RowBox[{"Eh", "(", "t", ")"}], 
                          FractionBox[RowBox[{"\[Sigma]", "-", "1"}], 
                          "\[Sigma]"]]}]}], ")"}], FractionBox["\[Sigma]", 
                          RowBox[{"\[Sigma]", "-", "1"}]]], ")"}], RowBox[
                          {"1", "-", "\[Gamma]"}]], "-", "1"}], RowBox[
                        {"1", "-", "\[Gamma]"}]], "-", FractionBox[RowBox[
                        {"\[Chi]", " ", SuperscriptBox["t", RowBox[{"\[Phi]", 
                          "+", "1"}]]}], RowBox[{"\[Phi]", "+", "1"}]]}], 
                    ")"}]}]}], TraditionalForm]], "Output", 
            CellLabel -> "Out[20]//TraditionalForm= ", ExpressionUUID -> 
             "a163607e-f2af-4e4a-a259-6495e1626bac"]}, Open]], 
        Cell[
         "Rozwi\:0105zuje Lagrangian poprzez znalezienie odpowiednich FOC:", 
         "Text", CellChangeTimes -> {{3.9802544126254387*^9, 
            3.980254432840664*^9}}, ExpressionUUID -> 
          "9e9c6132-5202-d845-a77f-05a5f72e950a"], 
        Cell[CellGroupData[{Cell["Step 12 \[LongDash] Differentiate with \
respect to non-energy consumption. Lt is the single-period contribution, \
including \[Beta]^t. householdsFOCCne stores its derivative; \
solhouseholdsFOCCne stores the solution for \[Lambda][t]. For positive \
consumption, the chain rule separates the marginal utility of the composite \
from the marginal contribution of Cne[t] to that composite.", "Text"], 
           Cell[BoxData[{RowBox[{RowBox[{"Lt", "=", RowBox[{RowBox[
                     {"\[Beta]", "^", "t"}], " ", RowBox[{"(", RowBox[
                       {RowBox[{"u", "[", "t", "]"}], "-", RowBox[
                         {RowBox[{"\[Lambda]", "[", "t", "]"}], " ", RowBox[
                          {"bc", "[", "t", "]"}]}]}], ")"}]}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"householdsFOCCne", "=", 
                  RowBox[{"D", "[", RowBox[{"Lt", ",", RowBox[{"Cne", "[", 
                        "t", "]"}]}], "]"}]}], ";"}], "\n", 
              RowBox[{"solhouseholdsFOCCne", " ", "=", "  ", RowBox[
                 {"First", "@", RowBox[{"Solve", "[", RowBox[{RowBox[
                       {"householdsFOCCne", "==", "0"}], ",", RowBox[
                       {"\[Lambda]", "[", "t", "]"}]}], "]"}]}]}]}], "Input", 
            CellChangeTimes -> {3.9802544030763187*^9, 
              {3.9802544468167114*^9, 3.980254469409603*^9}, 
              {3.9802546880058327*^9, 3.9802547065201187*^9}, 
              {3.980254810886698*^9, 3.9802548305613213*^9}, 
              {3.9802549396556187*^9, 3.980254951889105*^9}, 
              {3.980255050864649*^9, 3.9802550609035625*^9}, 
              {3.980255132149889*^9, 3.980255133622013*^9}}, 
            ExpressionUUID -> "643de2d9-b208-4fac-9070-05d3316afc71"], 
           Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"\[Lambda]", "[", "t", 
                   "]"}], "\[Rule]", RowBox[{RowBox[{"(", RowBox[{"1", "-", 
                       "\[Omega]"}], ")"}], " ", SuperscriptBox[RowBox[
                     {"Cne", "[", "t", "]"}], RowBox[{RowBox[{"-", "1"}], 
                      "+", FractionBox[RowBox[{RowBox[{"-", "1"}], "+", 
                         "\[Sigma]"}], "\[Sigma]"]}]], " ", SuperscriptBox[
                    RowBox[{"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{"1", 
                          "-", "\[Omega]"}], ")"}], " ", SuperscriptBox[
                          RowBox[{"Cne", "[", "t", "]"}], FractionBox[RowBox[
                          {RowBox[{"-", "1"}], "+", "\[Sigma]"}], 
                          "\[Sigma]"]]}], "+", RowBox[{"\[Omega]", " ", 
                          SuperscriptBox[RowBox[{"Eh", "[", "t", "]"}], 
                          FractionBox[RowBox[{RowBox[{"-", "1"}], "+", 
                          "\[Sigma]"}], "\[Sigma]"]]}]}], ")"}], RowBox[
                     {RowBox[{"-", "1"}], "+", FractionBox["\[Sigma]", 
                       RowBox[{RowBox[{"-", "1"}], "+", "\[Sigma]"}]]}]], 
                   " ", SuperscriptBox[RowBox[{"(", SuperscriptBox[RowBox[
                        {"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{"1", "-", 
                          "\[Omega]"}], ")"}], " ", SuperscriptBox[RowBox[
                          {"Cne", "[", "t", "]"}], FractionBox[RowBox[
                          {RowBox[{"-", "1"}], "+", "\[Sigma]"}], 
                          "\[Sigma]"]]}], "+", RowBox[{"\[Omega]", " ", 
                          SuperscriptBox[RowBox[{"Eh", "[", "t", "]"}], 
                          FractionBox[RowBox[{RowBox[{"-", "1"}], "+", 
                          "\[Sigma]"}], "\[Sigma]"]]}]}], ")"}], FractionBox[
                        "\[Sigma]", RowBox[{RowBox[{"-", "1"}], "+", 
                          "\[Sigma]"}]]], ")"}], RowBox[{"-", 
                      "\[Gamma]"}]]}]}], "}"}]], "Output", 
            CellLabel -> "Out[23]= ", ExpressionUUID -> 
             "ffbb9014-d71a-41fc-930f-e017cc5ead3f"]}, Open]], 
        Cell["Do r\[OAcute]wnania konsumpcji przyr\[OAcute]wnuje to co \
wychodzi z cen energii:", "Text", CellChangeTimes -> 
          {{3.980255352876911*^9, 3.9802553708523464*^9}}, 
         ExpressionUUID -> "8917a858-4bdc-7b4b-a200-c4913a896f86"], 
        Cell[CellGroupData[{Cell["Step 13 \[LongDash] Differentiate with \
respect to household energy. householdsFOCEh is the analogous derivative with \
respect to Eh[t]. The budget derivative contributes pe[t], which is why the \
expression for \[Lambda][t] contains division by the energy price. We require \
pe[t]>0 when interpreting this interior allocation.", "Text"], 
           Cell[BoxData[{RowBox[{RowBox[{"householdsFOCEh", "=", 
                  RowBox[{"D", "[", RowBox[{"Lt", ",", RowBox[{"Eh", "[", 
                        "t", "]"}]}], "]"}]}], ";"}], "\n", 
              RowBox[{"solhouseholdsFOCEh", " ", "=", "  ", RowBox[
                 {"First", "@", RowBox[{"Solve", "[", RowBox[{RowBox[
                       {"householdsFOCEh", "==", "0"}], ",", RowBox[
                       {"\[Lambda]", "[", "t", "]"}]}], "]"}]}]}]}], "Input", 
            CellChangeTimes -> {{3.980255387760992*^9, 3.980255397966486*^9}, 
              3.980255599825592*^9}, ExpressionUUID -> 
             "9c1ffea6-e3ec-4aff-8d88-d1623ba9c73b"], 
           Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"\[Lambda]", "[", "t", 
                   "]"}], "\[Rule]", FractionBox[RowBox[{"\[Omega]", " ", 
                    SuperscriptBox[RowBox[{"Eh", "[", "t", "]"}], RowBox[
                      {RowBox[{"-", "1"}], "+", FractionBox[RowBox[
                         {RowBox[{"-", "1"}], "+", "\[Sigma]"}], 
                        "\[Sigma]"]}]], " ", SuperscriptBox[RowBox[{"(", 
                       RowBox[{RowBox[{RowBox[{"(", RowBox[{"1", "-", 
                          "\[Omega]"}], ")"}], " ", SuperscriptBox[RowBox[
                          {"Cne", "[", "t", "]"}], FractionBox[RowBox[
                          {RowBox[{"-", "1"}], "+", "\[Sigma]"}], 
                          "\[Sigma]"]]}], "+", RowBox[{"\[Omega]", " ", 
                          SuperscriptBox[RowBox[{"Eh", "[", "t", "]"}], 
                          FractionBox[RowBox[{RowBox[{"-", "1"}], "+", 
                          "\[Sigma]"}], "\[Sigma]"]]}]}], ")"}], RowBox[
                      {RowBox[{"-", "1"}], "+", FractionBox["\[Sigma]", 
                        RowBox[{RowBox[{"-", "1"}], "+", "\[Sigma]"}]]}]], 
                    " ", SuperscriptBox[RowBox[{"(", SuperscriptBox[RowBox[
                         {"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{"1", "-", 
                          "\[Omega]"}], ")"}], " ", SuperscriptBox[RowBox[
                          {"Cne", "[", "t", "]"}], FractionBox[RowBox[
                          {RowBox[{"-", "1"}], "+", "\[Sigma]"}], 
                          "\[Sigma]"]]}], "+", RowBox[{"\[Omega]", " ", 
                          SuperscriptBox[RowBox[{"Eh", "[", "t", "]"}], 
                          FractionBox[RowBox[{RowBox[{"-", "1"}], "+", 
                          "\[Sigma]"}], "\[Sigma]"]]}]}], ")"}], FractionBox[
                         "\[Sigma]", RowBox[{RowBox[{"-", "1"}], "+", 
                          "\[Sigma]"}]]], ")"}], RowBox[{"-", 
                       "\[Gamma]"}]]}], RowBox[{"pe", "[", "t", "]"}]]}], 
               "}"}]], "Output", CellLabel -> "Out[25]= ", ExpressionUUID -> 
             "e5824df6-1495-450c-abe7-8b3c534f06f0"]}, Open]], 
